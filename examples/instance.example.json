{
  "name": "exampleco",
  "dataDir": ".e3d-corp/instance/exampleco",
  "llm": {
    "providers": {
      "local": {
        "kind": "local",
        "baseUrlEnvVar": "EXAMPLECO_LLM_BASE_URL",
        "modelEnvVar": "EXAMPLECO_LLM_MODEL"
      }
    }
  },
  "research": {
    "knowledgeBaseMcpUrl": "http://127.0.0.1:4110",
    "webSearchProvider": "example-search",
    "webSearchApiKeyEnvVar": "EXAMPLECO_WEB_SEARCH_API_KEY",
    "stripe": {
      "apiKeyEnvVar": "EXAMPLECO_STRIPE_SECRET_KEY",
      "lookbackDays": 14
    },
    "meta": {
      "tokenEnvVar": "EXAMPLECO_META_ADS_READ_TOKEN",
      "adAccountId": "000000000000000",
      "lookbackDays": 14,
      "campaigns": [
        {
          "key": "example_campaign_v1",
          "campaignId": "000000000000001",
          "label": "Example product - v1",
          "product": "example-product"
        }
      ],
      "opportunitySignalRules": [
        { "metric": "cost_per_landing_page_view", "window_days": 7, "degradation_pct": 0.3 }
      ]
    }
  },
  "creative": {
    "enginePath": "../e3d-creative",
    "outDir": ".e3d-corp/instance/exampleco/creative-commissions",
    "defaultProviders": {
      "conceptGeneration": "claude",
      "critique": "claude",
      "qa": "claude"
    }
  },
  "stripeOutcomeWebhook": {
    "signingSecretEnvVar": "EXAMPLECO_STRIPE_WEBHOOK_SIGNING_SECRET"
  },
  "adRiskPolicy": {
    "max_daily_spend_usd": 200,
    "max_monthly_spend_usd": 4000
  },
  "adMandateHealthCheck": {
    "autoSuspendEnabled": false
  },
  "eventSources": [],
  "roles": {
    "opportunity.prospect": {
      "provider": "local"
    },
    "opportunity.investing": {
      "provider": "local"
    },
    "opportunity.communicator": {
      "provider": "local"
    },
    "risk.assess": {
      "provider": "local"
    },
    "creative.brief": {
      "provider": "local"
    }
  },
  "outreach": {
    "provider": "ses",
    "region": "us-east-1",
    "fromEmail": "outreach@example.com",
    "fallbackToEmail": "hello@example.com"
  },
  "e3dTrade": {
    "baseUrl": "http://127.0.0.1:3001",
    "mandatePath": "/api/mandates/capital",
    "apiKeyEnvVar": "EXAMPLECO_E3D_TRADE_API_KEY",
    "timeoutMs": 5000,
    "maxAttempts": 3
  },
  "tradeOutcomeWebhook": {
    "tokenEnvVar": "EXAMPLECO_E3D_TRADE_OUTCOME_TOKEN"
  },
  "researchTopics": [
    "domains or trends worth a scheduled discovery pass, e.g. \"AI utilities for technical businesses\""
  ],
  "ownDomains": [
    "example.com"
  ],
  "scoring": {
    "weights": {
      "confidence": 0.6,
      "evidenceCount": 0.25,
      "recency": 0.15
    },
    "typeWeights": {
      "consulting-engagement": 1.2
    }
  },
  "web": {
    "authUserEnvVar": "EXAMPLECO_WEB_USER",
    "authPassEnvVar": "EXAMPLECO_WEB_PASS",
    "port": 3000
  },
  "authorityNotify": {
    "email": "ops@example.com",
    "command": "notify-authority"
  },
  "anchor": {
    "provider": "email",
    "toEmailEnvVar": "EXAMPLECO_ANCHOR_TO_EMAIL"
  }
}
