{
  "name": "exampleco",
  "dataDir": ".e3d-corp/instance/exampleco",
  "llm": {
    "baseUrlEnvVar": "EXAMPLECO_LLM_BASE_URL",
    "modelEnvVar": "EXAMPLECO_LLM_MODEL"
  },
  "research": {
    "futcoMcpUrl": "http://127.0.0.1:4110",
    "webSearchProvider": "example-search"
  },
  "eventSources": [],
  "roles": {
    "opportunity.prospect": {
      "provider": "local",
      "model": "$LLM_MODEL"
    }
  },
  "researchTopics": [
    "domains or trends worth a scheduled discovery pass, e.g. \"AI utilities for technical businesses\""
  ],
  "scoring": {
    "weights": {
      "confidence": 0.6,
      "evidenceCount": 0.25,
      "recency": 0.15
    },
    "typeWeights": {
      "consulting-engagement": 1.2
    }
  },
  "web": {
    "authUserEnvVar": "EXAMPLECO_WEB_USER",
    "authPassEnvVar": "EXAMPLECO_WEB_PASS",
    "port": 3000
  },
  "authorityNotify": {
    "email": "ops@example.com",
    "command": "notify-authority"
  }
}
