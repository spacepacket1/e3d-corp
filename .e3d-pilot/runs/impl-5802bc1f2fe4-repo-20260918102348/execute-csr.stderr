+++ b/test/riskAssess.test.js
@@ -0,0 +1,261 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { AUTHORITY_LEVELS, getRequiredAuthorityLevel } from '../lib/authority/policy.js';
+import {
+  normalizeAssessment,
+  normalizeVendorId,
+  parseAssessmentJson,
+  selectVendorHistory
+} from '../lib/roles/riskAssess.js';
+
+function eventRecord({ id, occurredAt, subjectId, payload = {}, type = 'vendor.note' }) {
+  return {
+    id,
+    type,
+    occurredAt,
+    source: 'test',
+    subject: { type: 'vendor', id: subjectId },
+    payload,
+    correlationId: 'risk-assess-test'
+  };
+}
+
+test('normalizeVendorId trims surrounding whitespace and lowercases', () => {
+  assert.equal(normalizeVendorId('  VeNdOr-42  '), 'vendor-42');
+});
+
+test('parseAssessmentJson strips a markdown fence and normalizeAssessment accepts all supported verdicts', () => {
+  const allowedEvidenceIds = new Set(['request-1', 'event-1', 'event-2']);
+  const cases = [
+    {
+      verdict: 'HOLD',
+      reasoning: '  Existing disputes justify a hold.  ',
+      riskFactors: ['  previous dispute  '],
+      evidenceEventIds: [' event-1 ']
+    },
+    {
+      verdict: 'APPROVE',
+      reasoning: '  History is clean and the request is routine. ',
+      riskFactors: [],
+      evidenceEventIds: []
+    },
+    {
+      verdict: 'CHECK',
+      reasoning: '  Need a manual check because the evidence is incomplete. ',
+      riskFactors: ['  missing invoice reference '],
+      evidenceEventIds: [' event-2 ']
+    }
+  ];
+
+  cases.forEach((assessment) => {
+    const parsed = parseAssessmentJson('```json\n' + JSON.stringify(assessment, null, 2) + '\n```');
+    const normalized = normalizeAssessment(parsed, allowedEvidenceIds);
+
+    assert.equal(normalized.verdict, assessment.verdict);
+    assert.equal(normalized.reasoning, assessment.reasoning.trim());
+    assert.deepEqual(normalized.riskFactors, assessment.riskFactors.map((factor) => factor.trim()));
+    assert.deepEqual(normalized.evidenceEventIds, assessment.evidenceEventIds.map((evidenceId) => evidenceId.trim()));
+  });
+});
+
+test('parseAssessmentJson rejects empty output and malformed JSON', () => {
+  assert.throws(() => parseAssessmentJson(''), /risk\.assess returned empty output/);
+  assert.throws(() => parseAssessmentJson('```json\nnot json\n```'), /risk\.assess returned invalid JSON/);
+});
+
+test('normalizeAssessment rejects extra keys, invalid verdicts, and missing fields', () => {
+  const allowedEvidenceIds = new Set(['request-1']);
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'Needs review',
+          riskFactors: [],
+          evidenceEventIds: [],
+          extra: true
+        },
+        allowedEvidenceIds
+      ),
+    /extra: is not allowed/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'DENY',
+          reasoning: 'Needs review',
+          riskFactors: [],
+          evidenceEventIds: []
+        },
+        allowedEvidenceIds
+      ),
+    /verdict: must be one of "HOLD", "APPROVE", or "CHECK"/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'CHECK',
+          reasoning: 'Needs review',
+          riskFactors: []
+        },
+        allowedEvidenceIds
+      ),
+    /evidenceEventIds: is required/
+  );
+});
+
+test('normalizeAssessment rejects blank risk factors, duplicate citations, and fabricated evidence ids', () => {
+  const allowedEvidenceIds = new Set(['request-1', 'event-1']);
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'Needs review',
+          riskFactors: ['   '],
+          evidenceEventIds: []
+        },
+        allowedEvidenceIds
+      ),
+    /riskFactors\[0\]: must be a non-empty string/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'Needs review',
+          riskFactors: [],
+          evidenceEventIds: ['event-1', ' event-1 ']
+        },
+        allowedEvidenceIds
+      ),
+    /evidenceEventIds: duplicate id "event-1"/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'CHECK',
+          reasoning: 'Needs review',
+          riskFactors: [],
+          evidenceEventIds: ['made-up-event']
+        },
+        allowedEvidenceIds
+      ),
+    /was not supplied to the role/
+  );
+});
+
+test('selectVendorHistory matches normalized vendor ids via subject.id and payload.vendorId and respects file-order tiebreaks', () => {
+  const requestEvent = eventRecord({
+    id: 'request-1',
+    occurredAt: '2026-09-18T10:00:00.000Z',
+    subjectId: 'request-1',
+    type: 'payment-request.received',
+    payload: { vendorId: '  vendor-123  ' }
+  });
+
+  const events = [
+    eventRecord({
+      id: 'older-subject-match',
+      occurredAt: '2026-09-18T08:00:00.000Z',
+      subjectId: ' Vendor-123 ',
+      payload: { note: 'old match by subject id' }
+    }),
+    eventRecord({
+      id: 'same-time-earlier',
+      occurredAt: '2026-09-18T10:00:00.000Z',
+      subjectId: 'different-vendor',
+      payload: { vendorId: 'vendor-123' }
+    }),
+    eventRecord({
+      id: 'same-time-latest-before-request',
+      occurredAt: '2026-09-18T10:00:00.000Z',
+      subjectId: 'different-vendor',
+      payload: { vendorId: ' Vendor-123 ' }
+    }),
+    eventRecord({
+      id: 'substring-only',
+      occurredAt: '2026-09-18T09:30:00.000Z',
+      subjectId: 'another-vendor',
+      payload: { note: 'mentions vendor-123 in free text but has no vendorId field' }
+    }),
+    requestEvent,
+    eventRecord({
+      id: 'same-time-after-request',
+      occurredAt: '2026-09-18T10:00:00.000Z',
+      subjectId: 'vendor-123',
+      payload: {}
+    }),
+    eventRecord({
+      id: 'earlier-time-after-request',
+      occurredAt: '2026-09-18T09:45:00.000Z',
+      subjectId: 'different-vendor',
+      payload: { vendorId: 'vendor-123' }
+    }),
+    eventRecord({
+      id: 'unrelated-vendor',
+      occurredAt: '2026-09-18T09:50:00.000Z',
+      subjectId: 'vendor-999',
+      payload: { vendorId: 'vendor-999' }
+    })
+  ];
+
+  assert.deepEqual(selectVendorHistory(events, requestEvent).map((event) => event.id), [
+    'same-time-latest-before-request',
+    'same-time-earlier',
+    'earlier-time-after-request',
+    'older-subject-match'
+  ]);
+});
+
+test('selectVendorHistory returns at most 20 newest relevant events', () => {
+  const requestEvent = eventRecord({
+    id: 'request-20',
+    occurredAt: '2026-09-18T12:00:00.000Z',
+    subjectId: 'request-20',
+    type: 'payment-request.received',
+    payload: { vendorId: 'vendor-20' }
+  });
+
+  const history = Array.from({ length: 25 }, (_, index) =>
+    eventRecord({
+      id: `history-${index}`,
+      occurredAt: `2026-09-18T11:${String(index).padStart(2, '0')}:00.000Z`,
+      subjectId: 'vendor-20'
+    })
+  );
+
+  const selected = selectVendorHistory([...history, requestEvent], requestEvent);
+
+  assert.equal(selected.length, 20);
+  assert.deepEqual(
+    selected.map((event) => event.id),
+    ['history-24', 'history-23', 'history-22', 'history-21', 'history-20', 'history-19', 'history-18', 'history-17', 'history-16', 'history-15', 'history-14', 'history-13', 'history-12', 'history-11', 'history-10', 'history-9', 'history-8', 'history-7', 'history-6', 'history-5']
+  );
+});
+
+test('selectVendorHistory returns an empty array when no prior events match the vendor', () => {
+  const requestEvent = eventRecord({
+    id: 'request-empty',
+    occurredAt: '2026-09-18T10:00:00.000Z',
+    subjectId: 'request-empty',
+    type: 'payment-request.received',
+    payload: { vendorId: 'vendor-empty' }
+  });
+
+  assert.deepEqual(selectVendorHistory([requestEvent], requestEvent), []);
+});
+
+test('flag-payment-request resolves to authority level 3', () => {
+  assert.equal(getRequiredAuthorityLevel('flag-payment-request'), AUTHORITY_LEVELS.FINANCIAL_ACTION);
+});

