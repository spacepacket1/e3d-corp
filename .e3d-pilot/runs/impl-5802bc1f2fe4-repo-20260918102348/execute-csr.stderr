diff --git a/lib/roles/riskAssess.js b/lib/roles/riskAssess.js
new file mode 100644
index 0000000000000000000000000000000000000000..238649dd8429abaa9e97127e6da8be5b40cf89c9
--- /dev/null
+++ b/lib/roles/riskAssess.js
@@ -0,0 +1,172 @@
+const ROLE_NAME = 'risk.assess';
+const ALLOWED_VERDICTS = new Set(['HOLD', 'APPROVE', 'CHECK']);
+const ASSESSMENT_KEYS = ['verdict', 'reasoning', 'riskFactors', 'evidenceEventIds'];
+
+function stripMarkdownFence(rawText) {
+  const trimmed = rawText.trim();
+  const fenced = trimmed.match(/^```(?:json)?\s*([\s\S]*?)\s*```$/i);
+  return fenced ? fenced[1].trim() : trimmed;
+}
+
+function isPlainObject(value) {
+  return value !== null && typeof value === 'object' && !Array.isArray(value) && Object.getPrototypeOf(value) === Object.prototype;
+}
+
+function normalizeAllowedEvidenceIds(allowedEvidenceIds) {
+  if (allowedEvidenceIds instanceof Set) {
+    return allowedEvidenceIds;
+  }
+  if (Array.isArray(allowedEvidenceIds)) {
+    return new Set(allowedEvidenceIds);
+  }
+  throw new Error('normalizeAssessment requires allowedEvidenceIds to be a Set or array');
+}
+
+export function normalizeVendorId(value) {
+  return typeof value === 'string' ? value.trim().toLowerCase() : '';
+}
+
+export function selectVendorHistory(events, requestEvent) {
+  if (!Array.isArray(events)) {
+    throw new Error('selectVendorHistory requires events to be an array');
+  }
+  if (!requestEvent || typeof requestEvent !== 'object') {
+    throw new Error('selectVendorHistory requires a request event object');
+  }
+
+  const requestIndex = events.findIndex((event) => event?.id === requestEvent.id);
+  if (requestIndex === -1) {
+    throw new Error(`selectVendorHistory could not find request event "${requestEvent.id}" in the event log`);
+  }
+
+  const requestVendorId = normalizeVendorId(requestEvent?.payload?.vendorId);
+  if (requestVendorId === '') {
+    return [];
+  }
+
+  const requestOccurredAt = new Date(requestEvent.occurredAt).getTime();
+
+  return events
+    .map((event, index) => ({ event, index, occurredAt: new Date(event?.occurredAt).getTime() }))
+    .filter(({ event, index, occurredAt }) => {
+      if (!event || event.id === requestEvent.id) {
+        return false;
+      }
+
+      const predatesRequest = occurredAt < requestOccurredAt || (occurredAt === requestOccurredAt && index < requestIndex);
+      if (!predatesRequest) {
+        return false;
+      }
+
+      const subjectMatch = normalizeVendorId(event?.subject?.id) === requestVendorId;
+      const payloadMatch =
+        typeof event?.payload?.vendorId === 'string' && normalizeVendorId(event.payload.vendorId) === requestVendorId;
+
+      return subjectMatch || payloadMatch;
+    })
+    .sort((left, right) => {
+      if (left.occurredAt !== right.occurredAt) {
+        return right.occurredAt - left.occurredAt;
+      }
+      return right.index - left.index;
+    })
+    .slice(0, 20)
+    .map(({ event }) => event);
+}
+
+export function parseAssessmentJson(rawText) {
+  if (typeof rawText !== 'string' || rawText.trim() === '') {
+    throw new Error(`${ROLE_NAME} returned empty output`);
+  }
+
+  try {
+    return JSON.parse(stripMarkdownFence(rawText));
+  } catch (error) {
+    throw new Error(`${ROLE_NAME} returned invalid JSON: ${error.message}`);
+  }
+}
+
+export function normalizeAssessment(parsed, allowedEvidenceIds) {
+  const allowedIds = normalizeAllowedEvidenceIds(allowedEvidenceIds);
+  const errors = [];
+
+  if (!isPlainObject(parsed)) {
+    throw new Error('Invalid risk assessment:\n- assessment: must be a plain object');
+  }
+
+  const keys = Object.keys(parsed);
+  const missingKeys = ASSESSMENT_KEYS.filter((key) => !Object.prototype.hasOwnProperty.call(parsed, key));
+  const extraKeys = keys.filter((key) => !ASSESSMENT_KEYS.includes(key));
+
+  missingKeys.forEach((key) => errors.push(`${key}: is required`));
+  extraKeys.forEach((key) => errors.push(`${key}: is not allowed`));
+
+  if (keys.length !== ASSESSMENT_KEYS.length && missingKeys.length === 0 && extraKeys.length === 0) {
+    errors.push('assessment: must contain exactly the expected own keys');
+  }
+
+  if (!ALLOWED_VERDICTS.has(parsed.verdict)) {
+    errors.push('verdict: must be one of "HOLD", "APPROVE", or "CHECK"');
+  }
+
+  if (typeof parsed.reasoning !== 'string' || parsed.reasoning.trim() === '') {
+    errors.push('reasoning: must be a non-empty string');
+  }
+
+  if (!Array.isArray(parsed.riskFactors)) {
+    errors.push('riskFactors: must be an array');
+  }
+
+  if (!Array.isArray(parsed.evidenceEventIds)) {
+    errors.push('evidenceEventIds: must be an array');
+  }
+
+  const normalizedRiskFactors = Array.isArray(parsed.riskFactors)
+    ? parsed.riskFactors.map((factor, index) => {
+        if (typeof factor !== 'string' || factor.trim() === '') {
+          errors.push(`riskFactors[${index}]: must be a non-empty string`);
+          return null;
+        }
+        return factor.trim();
+      })
+    : [];
+
+  const normalizedEvidenceEventIds = Array.isArray(parsed.evidenceEventIds)
+    ? parsed.evidenceEventIds.map((evidenceId, index) => {
+        if (typeof evidenceId !== 'string' || evidenceId.trim() === '') {
+          errors.push(`evidenceEventIds[${index}]: must be a non-empty string`);
+          return null;
+        }
+
+        const normalizedEvidenceId = evidenceId.trim();
+        if (!allowedIds.has(normalizedEvidenceId)) {
+          errors.push(`evidenceEventIds[${index}]: "${normalizedEvidenceId}" was not supplied to the role`);
+        }
+
+        return normalizedEvidenceId;
+      })
+    : [];
+
+  const duplicateEvidenceIds = new Set();
+  normalizedEvidenceEventIds.forEach((evidenceId) => {
+    if (evidenceId === null) {
+      return;
+    }
+    if (duplicateEvidenceIds.has(evidenceId)) {
+      errors.push(`evidenceEventIds: duplicate id "${evidenceId}"`);
+      return;
+    }
+    duplicateEvidenceIds.add(evidenceId);
+  });
+
+  if (errors.length > 0) {
+    throw new Error(`Invalid risk assessment:\n- ${errors.join('\n- ')}`);
+  }
+
+  return {
+    verdict: parsed.verdict,
+    reasoning: parsed.reasoning.trim(),
+    riskFactors: normalizedRiskFactors,
+    evidenceEventIds: normalizedEvidenceEventIds
+  };
+}
