+
+  try {
+    return JSON.parse(stripMarkdownFence(rawText));
+  } catch (error) {
+    throw new Error(`${ROLE_NAME} returned invalid JSON: ${error.message}`);
+  }
+}
+
+export function normalizeAssessment(parsed, allowedEvidenceIds) {
+  const allowedIds = normalizeAllowedEvidenceIds(allowedEvidenceIds);
+  const errors = [];
+
+  if (!isPlainObject(parsed)) {
+    throw new Error('Invalid risk assessment:\n- assessment: must be a plain object');
+  }
+
+  const keys = Object.keys(parsed);
+  const missingKeys = ASSESSMENT_KEYS.filter((key) => !Object.prototype.hasOwnProperty.call(parsed, key));
+  const extraKeys = keys.filter((key) => !ASSESSMENT_KEYS.includes(key));
+
+  missingKeys.forEach((key) => errors.push(`${key}: is required`));
+  extraKeys.forEach((key) => errors.push(`${key}: is not allowed`));
+
+  if (keys.length !== ASSESSMENT_KEYS.length && missingKeys.length === 0 && extraKeys.length === 0) {
+    errors.push('assessment: must contain exactly the expected own keys');
+  }
+
+  if (!ALLOWED_VERDICTS.has(parsed.verdict)) {
+    errors.push('verdict: must be one of "HOLD", "APPROVE", or "CHECK"');
+  }
+
+  if (typeof parsed.reasoning !== 'string' || parsed.reasoning.trim() === '') {
+    errors.push('reasoning: must be a non-empty string');
+  }
+
+  if (!Array.isArray(parsed.riskFactors)) {
+    errors.push('riskFactors: must be an array');
+  }
+
+  if (!Array.isArray(parsed.evidenceEventIds)) {
+    errors.push('evidenceEventIds: must be an array');
+  }
+
+  const normalizedRiskFactors = Array.isArray(parsed.riskFactors)
+    ? parsed.riskFactors.map((factor, index) => {
+        if (typeof factor !== 'string' || factor.trim() === '') {
+          errors.push(`riskFactors[${index}]: must be a non-empty string`);
+          return null;
+        }
+        return factor.trim();
+      })
+    : [];
+
+  const normalizedEvidenceEventIds = Array.isArray(parsed.evidenceEventIds)
+    ? parsed.evidenceEventIds.map((evidenceId, index) => {
+        if (typeof evidenceId !== 'string' || evidenceId.trim() === '') {
+          errors.push(`evidenceEventIds[${index}]: must be a non-empty string`);
+          return null;
+        }
+
+        const normalizedEvidenceId = evidenceId.trim();
+        if (!allowedIds.has(normalizedEvidenceId)) {
+          errors.push(`evidenceEventIds[${index}]: "${normalizedEvidenceId}" was not supplied to the role`);
+        }
+
+        return normalizedEvidenceId;
+      })
+    : [];
+
+  const duplicateEvidenceIds = new Set();
+  normalizedEvidenceEventIds.forEach((evidenceId) => {
+    if (evidenceId === null) {
+      return;
+    }
+    if (duplicateEvidenceIds.has(evidenceId)) {
+      errors.push(`evidenceEventIds: duplicate id "${evidenceId}"`);
+      return;
+    }
+    duplicateEvidenceIds.add(evidenceId);
+  });
+
+  if (errors.length > 0) {
+    throw new Error(`Invalid risk assessment:\n- ${errors.join('\n- ')}`);
+  }
+
+  return {
+    verdict: parsed.verdict,
+    reasoning: parsed.reasoning.trim(),
+    riskFactors: normalizedRiskFactors,
+    evidenceEventIds: normalizedEvidenceEventIds
+  };
+}
