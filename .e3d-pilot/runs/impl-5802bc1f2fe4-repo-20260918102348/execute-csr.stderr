      webSearchProvider: 'disabled'
    },
        eventSources: [],
        roles: { 'opportunity.prospect': { provider: 'local' } },
        ...extra
      },
      null,
      2
    )
  );
  return { name, instanceDir, dataDir: path.join(ROOT, dataDir) };
}

function cleanupTempInstance(instanceDir) {
