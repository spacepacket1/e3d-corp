diff --git a/lib/roles/riskAssess.js b/lib/roles/riskAssess.js
new file mode 100644
index 0000000000000000000000000000000000000000..8dc453dbf7e7205c5107fa6d1f4b70ffe641628c
--- /dev/null
+++ b/lib/roles/riskAssess.js
@@ -0,0 +1,150 @@
+const ROLE_NAME = 'risk.assess';
+const ASSESSMENT_KEYS = ['verdict', 'reasoning', 'riskFactors', 'evidenceEventIds'];
+const ALLOWED_VERDICTS = new Set(['HOLD', 'APPROVE', 'CHECK']);
+
+function isPlainObject(value) {
+  return value !== null && typeof value === 'object' && !Array.isArray(value) && Object.getPrototypeOf(value) === Object.prototype;
+}
+
+function isNonEmptyString(value) {
+  return typeof value === 'string' && value.trim() !== '';
+}
+
+function stripMarkdownFence(rawText) {
+  const trimmed = rawText.trim();
+  const fenced = trimmed.match(/^```(?:json)?\s*([\s\S]*?)\s*```$/i);
+  return fenced ? fenced[1].trim() : trimmed;
+}
+
+function asTimestamp(occurredAt) {
+  return new Date(occurredAt).getTime();
+}
+
+export function normalizeVendorId(value) {
+  return typeof value === 'string' ? value.trim().toLowerCase() : '';
+}
+
+export function selectVendorHistory(events, requestEvent) {
+  const requestVendorId = normalizeVendorId(requestEvent?.payload?.vendorId);
+  if (requestVendorId === '') {
+    return [];
+  }
+
+  const requestIndex = events.findIndex((event) => event?.id === requestEvent?.id);
+  const requestOccurredAt = asTimestamp(requestEvent?.occurredAt);
+
+  return events
+    .map((event, index) => ({ event, index }))
+    .filter(({ event, index }) => {
+      if (!event || event.id === requestEvent?.id) {
+        return false;
+      }
+
+      const eventOccurredAt = asTimestamp(event.occurredAt);
+      if (eventOccurredAt > requestOccurredAt) {
+        return false;
+      }
+      if (eventOccurredAt === requestOccurredAt && requestIndex !== -1 && index >= requestIndex) {
+        return false;
+      }
+
+      const subjectVendorId = normalizeVendorId(event.subject?.id);
+      const payloadVendorId =
+        typeof event.payload?.vendorId === 'string' ? normalizeVendorId(event.payload.vendorId) : '';
+
+      return subjectVendorId === requestVendorId || payloadVendorId === requestVendorId;
+    })
+    .sort((left, right) => {
+      const timeDiff = asTimestamp(right.event.occurredAt) - asTimestamp(left.event.occurredAt);
+      if (timeDiff !== 0) {
+        return timeDiff;
+      }
+      return right.index - left.index;
+    })
+    .slice(0, 20)
+    .map(({ event }) => event);
+}
+
+export function parseAssessmentJson(rawText) {
+  if (typeof rawText !== 'string' || rawText.trim() === '') {
+    throw new Error(`${ROLE_NAME} returned empty output`);
+  }
+
+  try {
+    return JSON.parse(stripMarkdownFence(rawText));
+  } catch (error) {
+    throw new Error(`${ROLE_NAME} returned invalid JSON: ${error.message}`);
+  }
+}
+
+export function normalizeAssessment(parsed, allowedEvidenceIds) {
+  if (!isPlainObject(parsed)) {
+    throw new Error(`${ROLE_NAME} assessment must be a plain object`);
+  }
+
+  const keys = Object.keys(parsed);
+  const missingKeys = ASSESSMENT_KEYS.filter((key) => !Object.hasOwn(parsed, key));
+  const extraKeys = keys.filter((key) => !ASSESSMENT_KEYS.includes(key));
+  if (missingKeys.length > 0 || extraKeys.length > 0 || keys.length !== ASSESSMENT_KEYS.length) {
+    const problems = [];
+    if (missingKeys.length > 0) {
+      problems.push(`missing keys: ${missingKeys.join(', ')}`);
+    }
+    if (extraKeys.length > 0) {
+      problems.push(`unexpected keys: ${extraKeys.join(', ')}`);
+    }
+    throw new Error(`${ROLE_NAME} assessment must contain exactly these keys: ${ASSESSMENT_KEYS.join(', ')} (${problems.join('; ')})`);
+  }
+
+  if (!ALLOWED_VERDICTS.has(parsed.verdict)) {
+    throw new Error(`${ROLE_NAME} assessment verdict must be one of HOLD, APPROVE, CHECK`);
+  }
+
+  if (!isNonEmptyString(parsed.reasoning)) {
+    throw new Error(`${ROLE_NAME} assessment reasoning must be a non-empty string`);
+  }
+
+  if (!Array.isArray(parsed.riskFactors)) {
+    throw new Error(`${ROLE_NAME} assessment riskFactors must be an array`);
+  }
+  const riskFactors = parsed.riskFactors.map((factor, index) => {
+    if (typeof factor !== 'string') {
+      throw new Error(`${ROLE_NAME} assessment riskFactors[${index}] must be a string`);
+    }
+    const trimmed = factor.trim();
+    if (trimmed === '') {
+      throw new Error(`${ROLE_NAME} assessment riskFactors[${index}] must not be blank`);
+    }
+    return trimmed;
+  });
+
+  if (!Array.isArray(parsed.evidenceEventIds)) {
+    throw new Error(`${ROLE_NAME} assessment evidenceEventIds must be an array`);
+  }
+  const allowedIds = new Set(allowedEvidenceIds);
+  const seenEvidenceIds = new Set();
+  const evidenceEventIds = parsed.evidenceEventIds.map((eventId, index) => {
+    if (typeof eventId !== 'string') {
+      throw new Error(`${ROLE_NAME} assessment evidenceEventIds[${index}] must be a string`);
+    }
+    const trimmed = eventId.trim();
+    if (trimmed === '') {
+      throw new Error(`${ROLE_NAME} assessment evidenceEventIds[${index}] must not be blank`);
+    }
+    if (seenEvidenceIds.has(trimmed)) {
+      throw new Error(`${ROLE_NAME} assessment evidenceEventIds must not contain duplicates`);
+    }
+    if (!allowedIds.has(trimmed)) {
+      throw new Error(`${ROLE_NAME} assessment evidenceEventIds must reference only supplied evidence event IDs`);
+    }
+    seenEvidenceIds.add(trimmed);
+    return trimmed;
+  });
+
+  return {
+    verdict: parsed.verdict,
+    reasoning: parsed.reasoning.trim(),
+    riskFactors,
+    evidenceEventIds
+  };
+}
