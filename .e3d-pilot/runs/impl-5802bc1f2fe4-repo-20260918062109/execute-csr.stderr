diff --git a/test/riskAssess.test.js b/test/riskAssess.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..9146d82c46844c050205b3fba54a07518b9c458d
--- /dev/null
+++ b/test/riskAssess.test.js
@@ -0,0 +1,265 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { AUTHORITY_LEVELS, getRequiredAuthorityLevel } from '../lib/authority/policy.js';
+import {
+  normalizeVendorId,
+  normalizeAssessment,
+  parseAssessmentJson,
+  selectVendorHistory
+} from '../lib/roles/riskAssess.js';
+
+function makeEvent({
+  id,
+  type = 'test.event',
+  occurredAt,
+  subject = { type: 'vendor', id: 'vendor-default' },
+  payload = {},
+  correlationId = 'corr-1'
+}) {
+  return { id, type, occurredAt, subject, payload, correlationId };
+}
+
+test('normalizeVendorId trims and lowercases vendor IDs', () => {
+  assert.equal(normalizeVendorId('  AcMe-Vendor  '), 'acme-vendor');
+  assert.equal(normalizeVendorId(''), '');
+  assert.equal(normalizeVendorId(null), '');
+});
+
+test('parseAssessmentJson strips markdown fences and normalizeAssessment accepts all verdicts', () => {
+  const allowedEvidenceIds = new Set(['request-1', 'history-1']);
+  const approve = normalizeAssessment(
+    parseAssessmentJson('```json\n{"verdict":"APPROVE","reasoning":"  Looks routine.  ","riskFactors":[],"evidenceEventIds":[]}\n```'),
+    allowedEvidenceIds
+  );
+  const hold = normalizeAssessment(
+    {
+      verdict: 'HOLD',
+      reasoning: '  Mismatch on amount. ',
+      riskFactors: ['  unusual amount  ', '  new bank details '],
+      evidenceEventIds: [' request-1 ', 'history-1']
+    },
+    allowedEvidenceIds
+  );
+  const check = normalizeAssessment(
+    {
+      verdict: 'CHECK',
+      reasoning: ' Need confirmation ',
+      riskFactors: [],
+      evidenceEventIds: [' history-1 ']
+    },
+    allowedEvidenceIds
+  );
+
+  assert.deepEqual(approve, {
+    verdict: 'APPROVE',
+    reasoning: 'Looks routine.',
+    riskFactors: [],
+    evidenceEventIds: []
+  });
+  assert.deepEqual(hold, {
+    verdict: 'HOLD',
+    reasoning: 'Mismatch on amount.',
+    riskFactors: ['unusual amount', 'new bank details'],
+    evidenceEventIds: ['request-1', 'history-1']
+  });
+  assert.deepEqual(check, {
+    verdict: 'CHECK',
+    reasoning: 'Need confirmation',
+    riskFactors: [],
+    evidenceEventIds: ['history-1']
+  });
+});
+
+test('parseAssessmentJson rejects malformed JSON and empty output', () => {
+  assert.throws(() => parseAssessmentJson(''), /risk\.assess returned empty output/);
+  assert.throws(() => parseAssessmentJson('```json\nnot json\n```'), /risk\.assess returned invalid JSON/);
+});
+
+test('normalizeAssessment rejects extra keys, invalid verdicts, missing fields, blank risk factors, duplicate citations, and fabricated evidence IDs', () => {
+  const allowedEvidenceIds = ['request-1', 'history-1'];
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'CHECK',
+          reasoning: 'ok',
+          riskFactors: [],
+          evidenceEventIds: [],
+          extra: true
+        },
+        allowedEvidenceIds
+      ),
+    /exactly these keys/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'DENY',
+          reasoning: 'ok',
+          riskFactors: [],
+          evidenceEventIds: []
+        },
+        allowedEvidenceIds
+      ),
+    /verdict must be one of HOLD, APPROVE, CHECK/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'CHECK',
+          reasoning: 'ok',
+          riskFactors: []
+        },
+        allowedEvidenceIds
+      ),
+    /exactly these keys/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'CHECK',
+          reasoning: 'ok',
+          riskFactors: ['   '],
+          evidenceEventIds: []
+        },
+        allowedEvidenceIds
+      ),
+    /riskFactors\[0\] must not be blank/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'CHECK',
+          reasoning: 'ok',
+          riskFactors: [],
+          evidenceEventIds: ['history-1', ' history-1 ']
+        },
+        allowedEvidenceIds
+      ),
+    /must not contain duplicates/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'CHECK',
+          reasoning: 'ok',
+          riskFactors: [],
+          evidenceEventIds: ['made-up']
+        },
+        allowedEvidenceIds
+      ),
+    /must reference only supplied evidence event IDs/
+  );
+});
+
+test('selectVendorHistory matches exact normalized vendor fields, excludes unrelated events and the request itself, and returns newest first', () => {
+  const request = makeEvent({
+    id: 'request-1',
+    type: 'payment-request.received',
+    occurredAt: '2026-09-18T12:00:00.000Z',
+    subject: { type: 'payment-request', id: 'request-1' },
+    payload: { vendorId: ' acme-co ' }
+  });
+  const events = [
+    makeEvent({
+      id: 'old-subject',
+      occurredAt: '2026-09-18T11:00:00.000Z',
+      subject: { type: 'vendor', id: ' ACME-CO ' }
+    }),
+    makeEvent({
+      id: 'old-payload',
+      occurredAt: '2026-09-18T11:30:00.000Z',
+      subject: { type: 'note', id: 'n1' },
+      payload: { vendorId: 'acme-co' }
+    }),
+    makeEvent({
+      id: 'same-time-earlier',
+      occurredAt: '2026-09-18T12:00:00.000Z',
+      subject: { type: 'vendor', id: 'acme-co' }
+    }),
+    makeEvent({
+      id: 'other-vendor',
+      occurredAt: '2026-09-18T11:45:00.000Z',
+      subject: { type: 'vendor', id: 'different-vendor' },
+      payload: { vendorId: 'different-vendor' }
+    }),
+    request,
+    makeEvent({
+      id: 'same-time-later',
+      occurredAt: '2026-09-18T12:00:00.000Z',
+      subject: { type: 'vendor', id: 'acme-co' }
+    }),
+    makeEvent({
+      id: 'future-match',
+      occurredAt: '2026-09-18T12:00:01.000Z',
+      subject: { type: 'vendor', id: 'acme-co' }
+    })
+  ];
+
+  assert.deepEqual(
+    selectVendorHistory(events, request).map((event) => event.id),
+    ['same-time-earlier', 'old-payload', 'old-subject']
+  );
+});
+
+test('selectVendorHistory bounds to the 20 newest same-vendor prior events and preserves same-occurredAt log ordering', () => {
+  const request = makeEvent({
+    id: 'request-2',
+    type: 'payment-request.received',
+    occurredAt: '2026-09-18T10:00:00.000Z',
+    subject: { type: 'payment-request', id: 'request-2' },
+    payload: { vendorId: 'vendor-42' }
+  });
+
+  const events = [];
+  for (let index = 0; index < 22; index += 1) {
+    events.push(
+      makeEvent({
+        id: `history-${index}`,
+        occurredAt: '2026-09-18T09:00:00.000Z',
+        subject: { type: 'vendor', id: 'vendor-42' }
+      })
+    );
+  }
+  events.push(request);
+
+  const selectedIds = selectVendorHistory(events, request).map((event) => event.id);
+  assert.equal(selectedIds.length, 20);
+  assert.deepEqual(selectedIds.slice(0, 3), ['history-21', 'history-20', 'history-19']);
+  assert.deepEqual(selectedIds.slice(-3), ['history-4', 'history-3', 'history-2']);
+});
+
+test('selectVendorHistory returns an empty array when there is no matching prior vendor history', () => {
+  const request = makeEvent({
+    id: 'request-3',
+    type: 'payment-request.received',
+    occurredAt: '2026-09-18T12:00:00.000Z',
+    subject: { type: 'payment-request', id: 'request-3' },
+    payload: { vendorId: 'vendor-x' }
+  });
+  const events = [
+    makeEvent({
+      id: 'unrelated',
+      occurredAt: '2026-09-18T11:00:00.000Z',
+      subject: { type: 'vendor', id: 'vendor-y' }
+    }),
+    request
+  ];
+
+  assert.deepEqual(selectVendorHistory(events, request), []);
+});
+
+test('flag-payment-request resolves to authority level 3', () => {
+  assert.equal(getRequiredAuthorityLevel('flag-payment-request'), AUTHORITY_LEVELS.FINANCIAL_ACTION);
+});

