+
+  const events = [];
+  for (let index = 0; index < 22; index += 1) {
+    events.push(
+      makeEvent({
+        id: `history-${index}`,
+        occurredAt: '2026-09-18T09:00:00.000Z',
+        subject: { type: 'vendor', id: 'vendor-42' }
+      })
+    );
+  }
+  events.push(request);
+
+  const selectedIds = selectVendorHistory(events, request).map((event) => event.id);
+  assert.equal(selectedIds.length, 20);
+  assert.deepEqual(selectedIds.slice(0, 3), ['history-21', 'history-20', 'history-19']);
+  assert.deepEqual(selectedIds.slice(-3), ['history-4', 'history-3', 'history-2']);
