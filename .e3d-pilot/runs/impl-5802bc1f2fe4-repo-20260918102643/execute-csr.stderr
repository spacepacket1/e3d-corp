+        const records = readAllEventRecords(instance.dataDir);
+        assert.equal(records.length, 3);
+        const requestEvent = records.find((event) => event.type === 'payment-request.received');
+        const proposalEvent = records.find((event) => event.type === 'proposal.created');
+
+        assert.ok(requestEvent);
+        assert.ok(proposalEvent);
+        assert.equal(requestEvent.source, 'cli');
+        assert.equal(requestEvent.subject.type, 'payment-request');
+        assert.equal(requestEvent.subject.id, requestEvent.payload.requestId);
+        assert.notEqual(requestEvent.id, requestEvent.payload.requestId);
+        assert.deepEqual(requestEvent.payload, {
+          requestId: requestEvent.payload.requestId,
+          vendorId: 'vendor-42',
+          vendorName: 'Vendor Forty Two',
+          amount: 1250.5,
+          currency: 'USD',
+          description: 'September invoice',
+          dueDate: '2026-09-30',
+          reference: 'REF-77'
+        });
+
+        const proposal = proposalEvent.payload;
+        assert.equal(proposal.type, 'flag-payment-request');
+        assert.equal(proposal.status, 'pending');
+        assert.equal(proposal.authorityLevel, 3);
+        assert.equal(proposal.causationId, requestEvent.id);
+        assert.equal(proposal.correlationId, requestEvent.correlationId);
+        assert.deepEqual(proposal.proposedBy, {
+          role: 'risk.assess',
+          provider: 'local',
+          model: 'test-local-model'
+        });
+        assert.deepEqual(proposal.payload.request, requestEvent.payload);
+        assert.deepEqual(proposal.payload.assessment, {
+          verdict: 'CHECK',
+          reasoning: 'Need manual confirmation before payment.',
+          riskFactors: ['Unverified due date'],
+          evidenceEventIds: [requestEvent.id, prior.id]
+        });
+        assert.equal(queryEvents(instance.dataDir, { type: 'proposal.approved' }).length, 0);
+        assert.equal(queryEvents(instance.dataDir, { type: 'proposal.rejected' }).length, 0);
+        assert.equal(queryEvents(instance.dataDir, { type: 'action.executed' }).length, 0);
+        assert.match(
+          result.stdout,
+          new RegExp(
+            `Submitted payment request event ${requestEvent.id}: verdict=CHECK proposalId=${proposal.id} status=pending authorityLevel=3`
+          )
+        );
+      } finally {
+        cleanupTempInstance(instance.instanceDir);
+      }
+    }
+  );
+});
+
+test('unknown request subcommands, including bare request, print help and return nonzero', () => {
+  for (const args of [
+    ['request'],
+    ['request', 'unknown']
+  ]) {
+    assert.throws(() => runCli(args), (error) => {
+      assert.equal(error.status, 1);
+      assert.match(error.stdout.toString(), /Usage:/);
+      assert.match(error.stdout.toString(), /request submit --instance <name> --vendor-id <id>/);
+      assert.match(error.stderr.toString(), /Unknown request command:/);
+      return true;
+    });
+  }
+});
+
+test('flag-payment-request has no action executor after the CLI module loads', () => {
+  assert.equal(getActionExecutor('flag-payment-request'), null);
+});

codex
**Phase 3**

Implemented the `request submit` CLI path and the example `risk.assess` config. The command now validates all required/optional flags before `loadInstance()` or any event write, appends one normalized `payment-request.received` event, awaits `runRiskAssess(...)`, and prints a concise success line with request event id, verdict, proposal id, pending status, and authority level. Bare or unknown `request` subcommands now print help and return nonzero, and generic `event add` behavior was left unchanged.

Focused Phase 3 coverage was added in `test/riskAssess.test.js` for CLI help, invalid input, end-to-end submission, request-group routing, and confirming there is still no `flag-payment-request` action executor. The handoff is in [.codex-spec-runner/summaries/phase-3.md](/var/folders/vn/jrwn6x0579v_26grcpvwp_200000gn/T/e3d-pilot.impl-5802bc1f2fe4-repo-20260918102643.dhBOID/.codex-spec-runner/summaries/phase-3.md).

**Verification**

Passed:
- `npm install`
- `node --check bin/e3d-corp`
- `node --test --test-skip-pattern='real knowledge-base results|records evidence for the repo lookup|real integration returns real repos' $(find test -name '*.test.js' ! -name 'e3dTradeAcceptance.test.js')`
- `node --test test/riskAssess.test.js`

`npm run check` still fails, but only for pre-existing unrelated suite issues:
- missing external module for `test/e3dTradeAcceptance.test.js`
- real knowledge-base integration tests in `test/phase3.test.js` and `test/phase8.test.js` returning `unavailable` instead of `ok`
