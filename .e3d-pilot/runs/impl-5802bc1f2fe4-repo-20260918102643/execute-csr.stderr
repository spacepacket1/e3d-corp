+async function requestSubmitCommand(args) {
+  if (args.includes('--help') || args.includes('-h')) {
+    printHelp();
+    return 0;
+  }
+
+  const flags = parseFlags(args);
+  const { instanceName, payload, correlationId } = validateRequestSubmitFlags(flags);
+  const { config, dataDir } = loadInstance(instanceName);
+
+  const requestEvent = appendEvent(dataDir, {
+    type: 'payment-request.received',
+    source: 'cli',
+    subject: { type: 'payment-request', id: payload.requestId },
+    payload,
+    causationId: null,
+    correlationId
+  });
+
+  const { proposal, assessment } = await runRiskAssess({
+    dataDir,
+    instanceConfig: config,
+    requestEvent
+  });
+
+  process.stdout.write(
+    `Submitted payment request event ${requestEvent.id}: verdict=${assessment.verdict} proposalId=${proposal.id} status=${proposal.status} authorityLevel=${proposal.authorityLevel}\n`
+  );
+  return 0;
+}
