+      model: 'test-local-model'
+    });
+    assert.ok(!Object.hasOwn(proposal.payload.request, 'reference'));
+  } finally {
+    fs.rmSync(dataDir, { recursive: true, force: true });
+  }
+});
+
+test('missing roles.risk.assess config throws before any provider call', async () => {
+  const dataDir = makeTempDataDir();
+  try {
+    const requestEvent = appendPaymentRequestEvent(dataDir, {
+      requestId: 'request-missing-config',
+      correlationId: 'corr-missing-config'
+    });
+
+    let calls = 0;
+    await assert.rejects(
+      runRiskAssess({
+        dataDir,
+        instanceConfig: makeInstanceConfig({ roles: {} }),
+        requestEvent,
+        llmClient: async () => {
+          calls += 1;
+          return llmResponse('{}');
+        }
+      }),
+      /Instance config is missing roles\.risk\.assess\.provider/
+    );
+    assert.equal(calls, 0);
+    assert.equal(queryEvents(dataDir, { type: 'proposal.created' }).length, 0);
+  } finally {
+    fs.rmSync(dataDir, { recursive: true, force: true });
+  }
+});

