+function appendPaymentRequestEvent(
+  dataDir,
+  {
+    requestId = 'request-1',
+    correlationId = 'corr-request-1',
+    occurredAt = '2026-09-18T10:00:00.000Z',
+    vendorId = ' vendor-42 ',
+    vendorName = '  Vendor Forty Two  ',
+    amount = 1250.5,
+    currency = ' usd ',
+    description = '  September invoice  ',
+    dueDate,
+    reference
+  } = {}
+) {
+  const payload = {
+    requestId,
+    vendorId,
+    vendorName,
+    amount,
+    currency,
+    description
+  };
+  if (dueDate !== undefined) payload.dueDate = dueDate;
+  if (reference !== undefined) payload.reference = reference;
+
+  return appendEvent(dataDir, {
+    id: requestId,
+    type: 'payment-request.received',
+    occurredAt,
+    source: 'cli',
+    subject: { type: 'payment-request', id: requestId },
+    payload,
+    causationId: null,
+    correlationId
+  });
+}
+
+function llmResponse(text, overrides = {}) {
+  return {
+    text,
+    usage: { promptTokens: 7, completionTokens: 11, totalTokens: 18 },
+    costUsd: 0.001,
+    ...overrides
+  };
+}
