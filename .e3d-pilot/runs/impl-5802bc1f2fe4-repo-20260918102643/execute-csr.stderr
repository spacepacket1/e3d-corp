 });
+
+test('runRiskAssess turns a stored payment request into exactly one pending flag-payment-request proposal for HOLD, APPROVE, and CHECK without any decision or action events', async () => {
+  for (const verdict of ['HOLD', 'APPROVE', 'CHECK']) {
+    const dataDir = makeTempDataDir();
+    try {
+      const prior = appendEvent(dataDir, {
+        type: 'invoice.recorded',
+        occurredAt: '2026-09-18T09:00:00.000Z',
+        source: 'test',
+        subject: { type: 'invoice', id: 'inv-1' },
+        payload: { vendorId: 'vendor-42', invoiceNumber: 'INV-001' },
+        correlationId: `corr-${verdict}`
+      });
+      const requestEvent = appendPaymentRequestEvent(dataDir, {
+        requestId: `request-${verdict.toLowerCase()}`,
+        correlationId: `corr-${verdict}`,
+        dueDate: '2026-09-30',
+        reference: verdict === 'APPROVE' ? undefined : '  REF-9  '
+      });
+
+      const result = await runRiskAssess({
+        dataDir,
+        instanceConfig: makeInstanceConfig(),
+        requestEvent,
+        llmClient: async () =>
+          llmResponse(
+            JSON.stringify({
+              verdict,
+              reasoning: `  ${verdict} reasoning  `,
+              riskFactors: verdict === 'APPROVE' ? [] : ['  vendor change  '],
+              evidenceEventIds: [requestEvent.id, prior.id]
+            })
+          )
+      });
+
+      assert.equal(result.proposal.type, 'flag-payment-request');
+      assert.equal(result.proposal.authorityLevel, 3);
+      assert.equal(result.proposal.status, 'pending');
+      assert.equal(result.proposal.causationId, requestEvent.id);
+      assert.equal(result.proposal.correlationId, requestEvent.correlationId);
+      assert.deepEqual(result.proposal.proposedBy, {
+        role: 'risk.assess',
+        provider: 'local',
+        model: 'test-local-model'
+      });
+      assert.deepEqual(result.proposal.payload.request, {
+        requestId: requestEvent.payload.requestId,
+        vendorId: 'vendor-42',
+        vendorName: 'Vendor Forty Two',
+        amount: 1250.5,
+        currency: 'USD',
+        description: 'September invoice',
+        dueDate: '2026-09-30',
+        ...(verdict === 'APPROVE' ? {} : { reference: 'REF-9' })
+      });
+      assert.equal(result.proposal.payload.assessment.verdict, verdict);
+      assert.equal(result.event.type, 'proposal.created');
+      assert.equal(result.event.causationId, requestEvent.id);
+      assert.equal(result.event.correlationId, requestEvent.correlationId);
+
+      const createdEvents = queryEvents(dataDir, { type: 'proposal.created' });
+      assert.equal(createdEvents.length, 1);
+      assert.equal(queryEvents(dataDir, { type: 'proposal.approved' }).length, 0);
+      assert.equal(queryEvents(dataDir, { type: 'proposal.rejected' }).length, 0);
+      assert.equal(readAllEventRecords(dataDir).filter((event) => event.type === 'capital-mandate.submitted').length, 0);
+    } finally {
+      fs.rmSync(dataDir, { recursive: true, force: true });
+    }
+  }
+});
+
+test('runRiskAssess sends only bounded vendor-relevant history and the exact allowed evidence ids to the role', async () => {
+  const dataDir = makeTempDataDir();
