+import { readAllEventRecords } from '../events/store.js';
+import { resolveProvider } from '../llm/registry.js';
+import { createProposal } from '../proposals/create.js';
+
 const ROLE_NAME = 'risk.assess';
 const ASSESSMENT_KEYS = ['verdict', 'reasoning', 'riskFactors', 'evidenceEventIds'];
 const VALID_VERDICTS = new Set(['HOLD', 'APPROVE', 'CHECK']);
@@ -39,6 +43,155 @@
   return typeof vendorId === 'string' ? vendorId.trim().toLowerCase() : null;
 }
 
+function isNonEmptyString(value) {
+  return typeof value === 'string' && value.trim() !== '';
+}
+
+function normalizeProviderName(providerConfig) {
+  if (typeof providerConfig === 'string' && providerConfig.trim() !== '') {
+    return providerConfig.trim();
+  }
+  if (Array.isArray(providerConfig)) {
+    const first = providerConfig[0];
+    if (typeof first === 'string' && first.trim() !== '') {
+      return first.trim();
+    }
+  }
+
+  throw new Error(`Instance config is missing roles.${ROLE_NAME}.provider`);
+}
+
+function resolveProviderCall({ instanceConfig, provider, llmClient }) {
+  if (!llmClient) {
+    const resolved = resolveProvider(instanceConfig, provider);
+    return { provider, model: resolved.model, call: resolved.call };
+  }
+
+  if (typeof llmClient === 'function') {
+    const { model } = resolveProvider(instanceConfig, provider);
+    return { provider, model, call: llmClient };
+  }
+
+  if (llmClient && typeof llmClient === 'object') {
+    const call = llmClient[provider];
+    if (typeof call !== 'function') {
+      throw new Error(`runRiskAssess is missing an llmClient stub for provider "${provider}"`);
+    }
+    const { model } = resolveProvider(instanceConfig, provider);
+    return { provider, model, call };
+  }
+
+  throw new Error('runRiskAssess requires llmClient to be a function or provider map when provided');
+}
+
+function normalizeRequestPayload(requestEvent) {
+  if (requestEvent?.type !== 'payment-request.received') {
+    throw new Error('runRiskAssess requires a payment-request.received event');
+  }
+  if (!isNonEmptyString(requestEvent.id)) {
+    throw new Error('runRiskAssess requires requestEvent.id');
+  }
+  if (!isNonEmptyString(requestEvent.correlationId)) {
+    throw new Error('runRiskAssess requires requestEvent.correlationId');
+  }
+
+  const payload = requestEvent.payload;
+  if (!payload || typeof payload !== 'object' || Array.isArray(payload)) {
+    throw new Error('runRiskAssess requires requestEvent.payload');
+  }
+
+  const requestId = isNonEmptyString(payload.requestId) ? payload.requestId.trim() : requestEvent.subject?.id?.trim();
+  const vendorId = normalizeVendorId(payload.vendorId);
+  const vendorName = typeof payload.vendorName === 'string' ? payload.vendorName.trim() : '';
+  const description = typeof payload.description === 'string' ? payload.description.trim() : '';
+  const currency = typeof payload.currency === 'string' ? payload.currency.trim().toUpperCase() : '';
+  const amount = payload.amount;
+
+  if (!isNonEmptyString(requestId)) {
+    throw new Error('runRiskAssess requires requestEvent.payload.requestId');
+  }
+  if (!vendorId) {
+    throw new Error('runRiskAssess requires requestEvent.payload.vendorId');
+  }
+  if (!isNonEmptyString(vendorName)) {
+    throw new Error('runRiskAssess requires requestEvent.payload.vendorName');
+  }
+  if (!Number.isFinite(amount) || amount <= 0) {
+    throw new Error('runRiskAssess requires requestEvent.payload.amount to be a positive number');
+  }
+  if (!/^[A-Z]{3}$/.test(currency)) {
+    throw new Error('runRiskAssess requires requestEvent.payload.currency to be a 3-letter code');
+  }
+  if (!isNonEmptyString(description)) {
+    throw new Error('runRiskAssess requires requestEvent.payload.description');
+  }
+
+  const normalized = {
+    requestId,
+    vendorId,
+    vendorName,
+    amount,
+    currency,
+    description
+  };
+
+  if (isNonEmptyString(payload.dueDate)) {
+    normalized.dueDate = payload.dueDate.trim();
+  }
+  if (isNonEmptyString(payload.reference)) {
+    normalized.reference = payload.reference.trim();
+  }
+
+  return normalized;
+}
+
+function buildSystemPrompt(companyName) {
+  return [
+    `You are the ${ROLE_NAME} role inside e3d-corp for ${companyName}.`,
+    'Assess one inbound payment request using only the supplied request event, the supplied prior vendor history, and the allowed evidence ids.',
+    'Your verdict is only a recommendation for a human reviewer.',
+    'APPROVE does not approve, execute, release, or pay anything.',
+    'Use CHECK when the evidence is insufficient, ambiguous, or contradictory.',
+    'Never invent facts, prior events, or evidence ids.',
+    'Respond with ONLY a single JSON object matching exactly this shape:',
+    '{"verdict":"HOLD"|"APPROVE"|"CHECK","reasoning":string,"riskFactors":string[],"evidenceEventIds":string[]}'
+  ].join('\n');
+}
+
+function summarizeEvent(event) {
+  return {
+    id: event.id,
+    type: event.type,
+    occurredAt: event.occurredAt,
+    source: event.source,
+    subject: event.subject,
+    payload: event.payload,
+    causationId: event.causationId ?? null,
+    correlationId: event.correlationId
+  };
+}
+
+function buildPrompt({ instanceConfig, requestEvent, priorEvents, allowedEvidenceEventIds }) {
+  return {
+    systemPrompt: buildSystemPrompt(instanceConfig?.name || 'the company'),
+    userPrompt: JSON.stringify(
+      {
+        requestEvent: summarizeEvent(requestEvent),
+        priorVendorEvents: priorEvents.map(summarizeEvent),
+        allowedEvidenceEventIds,
+        instructions: {
+          verdicts: ['HOLD', 'APPROVE', 'CHECK'],
+          approveIsRecommendationOnly: true,
+          useCheckWhenEvidenceIsInsufficientOrAmbiguous: true,
+          neverInventFactsOrEvidenceIds: true
+        }
+      },
+      null,
+      2
+    )
+  };
+}
+
 export function selectVendorHistory(events, requestEvent) {
   if (!Array.isArray(events)) {
     throw new Error(`${ROLE_NAME} selectVendorHistory requires events to be an array`);
@@ -173,3 +326,44 @@
     evidenceEventIds
   };
 }
+
+export async function runRiskAssess({ dataDir, instanceConfig, requestEvent, llmClient } = {}) {
+  if (!dataDir) {
+    throw new Error('runRiskAssess requires a dataDir');
+  }
+
+  const provider = normalizeProviderName(instanceConfig?.roles?.[ROLE_NAME]?.provider);
+  const normalizedRequest = normalizeRequestPayload(requestEvent);
+  const { model, call } = resolveProviderCall({ instanceConfig, provider, llmClient });
+
+  const events = readAllEventRecords(dataDir);
+  const priorEvents = selectVendorHistory(events, requestEvent);
+  const allowedEvidenceEventIds = [requestEvent.id, ...priorEvents.map((event) => event.id)];
+  const { systemPrompt, userPrompt } = buildPrompt({
+    instanceConfig,
+    requestEvent,
+    priorEvents,
+    allowedEvidenceEventIds
+  });
+
+  const response = await call({ systemPrompt, userPrompt });
+  const assessment = normalizeAssessment(parseAssessmentJson(response?.text), allowedEvidenceEventIds);
+  const created = createProposal(dataDir, {
+    type: 'flag-payment-request',
+    causationId: requestEvent.id,
+    correlationId: requestEvent.correlationId,
+    instanceConfig,
+    proposedBy: { role: ROLE_NAME, provider, model },
+    payload: {
+      requestEventId: requestEvent.id,
+      request: normalizedRequest,
+      assessment
+    }
+  });
+
+  return {
+    proposal: created.proposal,
+    event: created.event,
+    assessment
+  };
+}
