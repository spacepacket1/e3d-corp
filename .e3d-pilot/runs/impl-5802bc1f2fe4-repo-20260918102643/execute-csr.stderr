diff --git a/test/riskAssess.test.js b/test/riskAssess.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..b33a8618beaaa668034969ef76f5976147f36534
--- /dev/null
+++ b/test/riskAssess.test.js
@@ -0,0 +1,318 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { AUTHORITY_LEVELS, getRequiredAuthorityLevel } from '../lib/authority/policy.js';
+import {
+  normalizeVendorId,
+  normalizeAssessment,
+  parseAssessmentJson,
+  selectVendorHistory
+} from '../lib/roles/riskAssess.js';
+
+function makeEvent({
+  id,
+  type = 'note.recorded',
+  occurredAt,
+  subject = { type: 'vendor', id: 'vendor-default' },
+  payload = {},
+  correlationId = 'corr-1'
+}) {
+  return {
+    id,
+    type,
+    occurredAt,
+    source: 'test',
+    subject,
+    payload,
+    causationId: null,
+    correlationId
+  };
+}
+
+test('normalizeVendorId trims and lowercases vendor ids', () => {
+  assert.equal(normalizeVendorId('  VeNdOr-123  '), 'vendor-123');
+  assert.equal(normalizeVendorId(''), '');
+  assert.equal(normalizeVendorId(null), null);
+});
+
+test('parseAssessmentJson accepts bare JSON and fenced JSON', () => {
+  assert.deepEqual(parseAssessmentJson('{"verdict":"HOLD"}'), { verdict: 'HOLD' });
+  assert.deepEqual(parseAssessmentJson('```json\n{"verdict":"CHECK"}\n```'), { verdict: 'CHECK' });
+});
+
+test('parseAssessmentJson rejects empty and malformed JSON', () => {
+  assert.throws(() => parseAssessmentJson('   '), /risk\.assess returned empty output/);
+  assert.throws(() => parseAssessmentJson('```\n   \n```'), /risk\.assess returned empty output/);
+  assert.throws(() => parseAssessmentJson('{not json}'), /risk\.assess returned invalid JSON/);
+});
+
+test('normalizeAssessment accepts and normalizes all supported verdicts, including empty arrays', () => {
+  const allowedEvidenceIds = ['request-1', 'event-1', 'event-2'];
+
+  assert.deepEqual(
+    normalizeAssessment(
+      {
+        verdict: 'HOLD',
+        reasoning: '  Elevated payment mismatch.  ',
+        riskFactors: ['  New bank details  ', ' Urgent due date '],
+        evidenceEventIds: [' event-1 ', 'event-2']
+      },
+      allowedEvidenceIds
+    ),
+    {
+      verdict: 'HOLD',
+      reasoning: 'Elevated payment mismatch.',
+      riskFactors: ['New bank details', 'Urgent due date'],
+      evidenceEventIds: ['event-1', 'event-2']
+    }
+  );
+
+  assert.deepEqual(
+    normalizeAssessment(
+      {
+        verdict: 'APPROVE',
+        reasoning: '  Prior invoices and counterparty match. ',
+        riskFactors: [],
+        evidenceEventIds: []
+      },
+      allowedEvidenceIds
+    ),
+    {
+      verdict: 'APPROVE',
+      reasoning: 'Prior invoices and counterparty match.',
+      riskFactors: [],
+      evidenceEventIds: []
+    }
+  );
+
+  assert.deepEqual(
+    normalizeAssessment(
+      {
+        verdict: 'CHECK',
+        reasoning: ' Need a manual callback. ',
+        riskFactors: [' ambiguous invoice thread '],
+        evidenceEventIds: [' request-1 ']
+      },
+      new Set(allowedEvidenceIds)
+    ),
+    {
+      verdict: 'CHECK',
+      reasoning: 'Need a manual callback.',
+      riskFactors: ['ambiguous invoice thread'],
+      evidenceEventIds: ['request-1']
+    }
+  );
+});
+
+test('normalizeAssessment rejects extra keys, invalid verdicts, missing fields, blank risk factors, duplicate evidence ids, and fabricated ids', () => {
+  const allowedEvidenceIds = ['request-1', 'event-1'];
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'ok',
+          riskFactors: [],
+          evidenceEventIds: [],
+          extra: true
+        },
+        allowedEvidenceIds
+      ),
+    /must contain exactly these keys/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'DENY',
+          reasoning: 'ok',
+          riskFactors: [],
+          evidenceEventIds: []
+        },
+        allowedEvidenceIds
+      ),
+    /verdict must be one of HOLD, APPROVE, CHECK/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'ok',
+          riskFactors: []
+        },
+        allowedEvidenceIds
+      ),
+    /must contain exactly these keys/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'ok',
+          riskFactors: ['  '],
+          evidenceEventIds: []
+        },
+        allowedEvidenceIds
+      ),
+    /riskFactors must not contain blank strings/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'ok',
+          riskFactors: [],
+          evidenceEventIds: ['event-1', ' event-1 ']
+        },
+        allowedEvidenceIds
+      ),
+    /evidenceEventIds must not contain duplicates/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'ok',
+          riskFactors: [],
+          evidenceEventIds: ['invented-id']
+        },
+        allowedEvidenceIds
+      ),
+    /must only cite supplied event ids/
+  );
+});
+
+test('selectVendorHistory matches exact normalized vendor ids via subject.id and payload.vendorId, excludes the request and unrelated vendors, and keeps newest first', () => {
+  const requestEvent = makeEvent({
+    id: 'request-1',
+    type: 'payment-request.received',
+    occurredAt: '2026-09-18T10:00:00.000Z',
+    subject: { type: 'payment-request', id: 'request-1' },
+    payload: { vendorId: ' Vendor-42 ' }
+  });
+
+  const events = [
+    makeEvent({
+      id: 'older-subject',
+      occurredAt: '2026-09-18T09:00:00.000Z',
+      subject: { type: 'vendor', id: 'VENDOR-42' }
+    }),
+    makeEvent({
+      id: 'unrelated',
+      occurredAt: '2026-09-18T09:30:00.000Z',
+      subject: { type: 'vendor', id: 'vendor-77' },
+      payload: { vendorId: 'vendor-77' }
+    }),
+    makeEvent({
+      id: 'newer-payload',
+      occurredAt: '2026-09-18T09:45:00.000Z',
+      subject: { type: 'invoice', id: 'inv-1' },
+      payload: { vendorId: ' vendor-42 ' }
+    }),
+    requestEvent
+  ];
+
+  assert.deepEqual(
+    selectVendorHistory(events, requestEvent).map((event) => event.id),
+    ['newer-payload', 'older-subject']
+  );
+});
+
+test('selectVendorHistory treats same-occurredAt earlier log entries as prior history and later ones as newer than the request', () => {
+  const sameTime = '2026-09-18T10:00:00.000Z';
+  const requestEvent = makeEvent({
+    id: 'request-2',
+    type: 'payment-request.received',
+    occurredAt: sameTime,
+    subject: { type: 'payment-request', id: 'request-2' },
+    payload: { vendorId: 'vendor-9' }
+  });
+
+  const events = [
+    makeEvent({
+      id: 'earlier-same-ms',
+      occurredAt: sameTime,
+      subject: { type: 'invoice', id: 'inv-2' },
+      payload: { vendorId: ' vendor-9 ' }
+    }),
+    requestEvent,
+    makeEvent({
+      id: 'later-same-ms',
+      occurredAt: sameTime,
+      subject: { type: 'invoice', id: 'inv-3' },
+      payload: { vendorId: 'vendor-9' }
+    })
+  ];
+
+  assert.deepEqual(
+    selectVendorHistory(events, requestEvent).map((event) => event.id),
+    ['earlier-same-ms']
+  );
+});
+
+test('selectVendorHistory bounds to the 20 newest matching events and returns empty history when nothing matches', () => {
+  const requestEvent = makeEvent({
+    id: 'request-3',
+    type: 'payment-request.received',
+    occurredAt: '2026-09-18T12:00:00.000Z',
+    subject: { type: 'payment-request', id: 'request-3' },
+    payload: { vendorId: 'vendor-bounded' }
+  });
+
+  const matchingEvents = Array.from({ length: 25 }, (_, index) =>
+    makeEvent({
+      id: `event-${index}`,
+      occurredAt: `2026-09-18T11:${String(index).padStart(2, '0')}:00.000Z`,
+      subject: { type: 'invoice', id: `invoice-${index}` },
+      payload: { vendorId: 'vendor-bounded' }
+    })
+  );
+  const events = [...matchingEvents, requestEvent];
+
+  const selectedIds = selectVendorHistory(events, requestEvent).map((event) => event.id);
+  assert.equal(selectedIds.length, 20);
+  assert.deepEqual(selectedIds, [
+    'event-24',
+    'event-23',
+    'event-22',
+    'event-21',
+    'event-20',
+    'event-19',
+    'event-18',
+    'event-17',
+    'event-16',
+    'event-15',
+    'event-14',
+    'event-13',
+    'event-12',
+    'event-11',
+    'event-10',
+    'event-9',
+    'event-8',
+    'event-7',
+    'event-6',
+    'event-5'
+  ]);
+
+  const noHistoryRequest = makeEvent({
+    id: 'request-4',
+    type: 'payment-request.received',
+    occurredAt: '2026-09-18T12:00:00.000Z',
+    subject: { type: 'payment-request', id: 'request-4' },
+    payload: { vendorId: 'vendor-none' }
+  });
+  assert.deepEqual(selectVendorHistory([noHistoryRequest], noHistoryRequest), []);
+});
+
+test('authority policy maps flag-payment-request to level 3', () => {
+  assert.equal(getRequiredAuthorityLevel('flag-payment-request'), AUTHORITY_LEVELS.FINANCIAL_ACTION);
+});

