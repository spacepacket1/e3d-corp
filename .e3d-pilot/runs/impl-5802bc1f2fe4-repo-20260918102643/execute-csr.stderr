import assert from 'node:assert/strict';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import test from 'node:test';
import { AUTHORITY_LEVELS, getRequiredAuthorityLevel } from '../lib/authority/policy.js';
import { appendEvent, queryEvents, readAllEventRecords } from '../lib/events/store.js';
import {
  normalizeVendorId,
  normalizeAssessment,
  parseAssessmentJson,
  runRiskAssess,
  selectVendorHistory
} from '../lib/roles/riskAssess.js';

const ORIGINAL_LLM_BASE_URL = process.env.LLM_BASE_URL;
const ORIGINAL_LLM_MODEL = process.env.LLM_MODEL;
process.env.LLM_BASE_URL = process.env.LLM_BASE_URL ?? 'http://127.0.0.1:9999';
process.env.LLM_MODEL = process.env.LLM_MODEL ?? 'test-local-model';
test.after(() => {
  if (ORIGINAL_LLM_BASE_URL === undefined) {
    delete process.env.LLM_BASE_URL;
  } else {
    process.env.LLM_BASE_URL = ORIGINAL_LLM_BASE_URL;
  }
  if (ORIGINAL_LLM_MODEL === undefined) {
    delete process.env.LLM_MODEL;
  } else {
    process.env.LLM_MODEL = ORIGINAL_LLM_MODEL;
  }
});

function makeTempDataDir() {
  return fs.mkdtempSync(path.join(os.tmpdir(), 'e3d-corp-risk-assess-'));
}

function makeInstanceConfig(overrides = {}) {
  return {
    name: 'Risk Test Co',
    llm: {
      providers: {
        local: { kind: 'local', baseUrlEnvVar: 'LLM_BASE_URL', modelEnvVar: 'LLM_MODEL' }
      }
    },
    roles: {
      'risk.assess': { provider: 'local' }
    },
    ...overrides
  };
}

function makeEvent({
  id,
  type = 'note.recorded',
  occurredAt,
  subject = { type: 'vendor', id: 'vendor-default' },
  payload = {},
  correlationId = 'corr-1'
}) {
  return {
    id,
    type,
    occurredAt,
    source: 'test',
    subject,
    payload,
    causationId: null,
    correlationId
  };
}

function appendPaymentRequestEvent(
  dataDir,
  {
    requestId = 'request-1',
    correlationId = 'corr-request-1',
    occurredAt = '2026-09-18T10:00:00.000Z',
    vendorId = ' vendor-42 ',
    vendorName = '  Vendor Forty Two  ',
    amount = 1250.5,
    currency = ' usd ',
    description = '  September invoice  ',
    dueDate,
    reference
  } = {}
) {
  const payload = {
    requestId,
