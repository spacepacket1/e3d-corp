+  const dataDir = makeTempDataDir();
+  try {
+    for (let index = 0; index < 25; index += 1) {
+      appendEvent(dataDir, {
+        id: `event-${index}`,
+        type: 'invoice.recorded',
+        occurredAt: `2026-09-18T09:${String(index).padStart(2, '0')}:00.000Z`,
+        source: 'test',
+        subject: { type: 'invoice', id: `invoice-${index}` },
+        payload: { vendorId: 'vendor-42', sequence: index },
+        correlationId: 'corr-bounded'
+      });
+    }
+    appendEvent(dataDir, {
+      id: 'event-unrelated',
+      type: 'invoice.recorded',
+      occurredAt: '2026-09-18T09:59:00.000Z',
+      source: 'test',
+      subject: { type: 'invoice', id: 'invoice-unrelated' },
+      payload: { vendorId: 'vendor-77' },
+      correlationId: 'corr-bounded'
+    });
+    const requestEvent = appendPaymentRequestEvent(dataDir, {
+      requestId: 'request-bounded',
+      correlationId: 'corr-bounded',
+      occurredAt: '2026-09-18T10:00:00.000Z'
+    });
+
+    let seenSystemPrompt = null;
+    let seenInput = null;
+    await runRiskAssess({
+      dataDir,
+      instanceConfig: makeInstanceConfig(),
+      requestEvent,
+      llmClient: async ({ systemPrompt, userPrompt }) => {
+        seenSystemPrompt = systemPrompt;
+        seenInput = JSON.parse(userPrompt);
+        return llmResponse(
+          JSON.stringify({
+            verdict: 'CHECK',
+            reasoning: 'Need callback confirmation.',
+            riskFactors: ['Unverified invoice context'],
+            evidenceEventIds: [requestEvent.id]
+          })
+        );
+      }
+    });
+
+    assert.match(seenSystemPrompt, /APPROVE does not approve, execute, release, or pay anything/);
+    assert.match(seenSystemPrompt, /Use CHECK when the evidence is insufficient, ambiguous, or contradictory/);
+    assert.equal(seenInput.requestEvent.id, requestEvent.id);
+    assert.equal(seenInput.priorVendorEvents.length, 20);
+    assert.deepEqual(
+      seenInput.priorVendorEvents.map((event) => event.id),
+      [
+        'event-24',
+        'event-23',
+        'event-22',
+        'event-21',
+        'event-20',
+        'event-19',
+        'event-18',
+        'event-17',
+        'event-16',
+        'event-15',
+        'event-14',
+        'event-13',
+        'event-12',
+        'event-11',
+        'event-10',
+        'event-9',
+        'event-8',
+        'event-7',
+        'event-6',
+        'event-5'
+      ]
+    );
+    assert.ok(seenInput.priorVendorEvents.every((event) => event.payload.vendorId === 'vendor-42'));
+    assert.deepEqual(seenInput.allowedEvidenceEventIds, [
+      requestEvent.id,
+      'event-24',
+      'event-23',
+      'event-22',
+      'event-21',
+      'event-20',
+      'event-19',
+      'event-18',
+      'event-17',
+      'event-16',
+      'event-15',
+      'event-14',
+      'event-13',
+      'event-12',
+      'event-11',
+      'event-10',
+      'event-9',
+      'event-8',
+      'event-7',
+      'event-6',
+      'event-5'
+    ]);
+  } finally {
+    fs.rmSync(dataDir, { recursive: true, force: true });
+  }
+});
+
+test('invalid or ungrounded role output leaves the stored request event in place and creates no proposal', async () => {
+  const dataDir = makeTempDataDir();
+  try {
+    const requestEvent = appendPaymentRequestEvent(dataDir, {
+      requestId: 'request-invalid',
+      correlationId: 'corr-invalid'
+    });
+
+    await assert.rejects(
+      runRiskAssess({
+        dataDir,
+        instanceConfig: makeInstanceConfig(),
+        requestEvent,
+        llmClient: async () =>
+          llmResponse(
+            JSON.stringify({
+              verdict: 'HOLD',
+              reasoning: 'Escalate for review.',
+              riskFactors: ['Bank account changed'],
+              evidenceEventIds: ['invented-evidence-id']
+            })
+          )
+      }),
+      /must only cite supplied event ids/
+    );
+
+    const records = readAllEventRecords(dataDir);
+    assert.equal(records.length, 1);
+    assert.equal(records[0].type, 'payment-request.received');
+    assert.equal(records[0].id, requestEvent.id);
+    assert.equal(queryEvents(dataDir, { type: 'proposal.created' }).length, 0);
+  } finally {
+    fs.rmSync(dataDir, { recursive: true, force: true });
+  }
+});
+
+test('runRiskAssess attributes provider and model from configuration, not from response metadata', async () => {
+  const dataDir = makeTempDataDir();
+  try {
+    const requestEvent = appendPaymentRequestEvent(dataDir, {
+      requestId: 'request-attribution',
+      correlationId: 'corr-attribution',
+      reference: ''
+    });
+
+    const { proposal } = await runRiskAssess({
+      dataDir,
+      instanceConfig: makeInstanceConfig({
+        roles: {
+          'risk.assess': { provider: ['local', 'ignored-secondary'] }
+        }
+      }),
+      requestEvent,
+      llmClient: async () =>
+        llmResponse(
+          JSON.stringify({
+            verdict: 'APPROVE',
+            reasoning: 'Matches known vendor history.',
+            riskFactors: [],
+            evidenceEventIds: [requestEvent.id]
+          }),
+          { model: 'hallucinated-model', provider: 'hallucinated-provider' }
+        )
+    });
+
+    assert.deepEqual(proposal.proposedBy, {
+      role: 'risk.assess',
+      provider: 'local',
+      model: 'test-local-model'
+    });
+    assert.ok(!Object.hasOwn(proposal.payload.request, 'reference'));
+  } finally {
+    fs.rmSync(dataDir, { recursive: true, force: true });
+  }
+});
+
+test('missing roles.risk.assess config throws before any provider call', async () => {
+  const dataDir = makeTempDataDir();
+  try {
+    const requestEvent = appendPaymentRequestEvent(dataDir, {
+      requestId: 'request-missing-config',
+      correlationId: 'corr-missing-config'
+    });
+
+    let calls = 0;
+    await assert.rejects(
+      runRiskAssess({
+        dataDir,
+        instanceConfig: makeInstanceConfig({ roles: {} }),
+        requestEvent,
+        llmClient: async () => {
+          calls += 1;
+          return llmResponse('{}');
+        }
+      }),
+      /Instance config is missing roles\.risk\.assess\.provider/
+    );
+    assert.equal(calls, 0);
+    assert.equal(queryEvents(dataDir, { type: 'proposal.created' }).length, 0);
+  } finally {
+    fs.rmSync(dataDir, { recursive: true, force: true });
+  }
+});

