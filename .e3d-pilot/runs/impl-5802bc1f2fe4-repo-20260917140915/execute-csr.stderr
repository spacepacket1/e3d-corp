diff --git a/lib/roles/riskAssess.js b/lib/roles/riskAssess.js
new file mode 100644
index 0000000000000000000000000000000000000000..ea9a01d6188e697241279fb1546f471d8b83c1a6
--- /dev/null
+++ b/lib/roles/riskAssess.js
@@ -0,0 +1,179 @@
+const ROLE_NAME = 'risk.assess';
+const ASSESSMENT_KEYS = ['verdict', 'reasoning', 'riskFactors', 'evidenceEventIds'];
+const ASSESSMENT_VERDICTS = new Set(['HOLD', 'APPROVE', 'CHECK']);
+
+export function normalizeVendorId(value) {
+  if (typeof value !== 'string') {
+    return '';
+  }
+  return value.trim().toLowerCase();
+}
+
+function eventPredatesRequest(event, eventIndex, requestEvent, requestIndex) {
+  const eventTime = Date.parse(event?.occurredAt);
+  const requestTime = Date.parse(requestEvent?.occurredAt);
+
+  if (eventTime < requestTime) {
+    return true;
+  }
+  if (eventTime > requestTime) {
+    return false;
+  }
+  return eventIndex < requestIndex;
+}
+
+function matchesVendor(normalizedVendorId, event) {
+  if (normalizedVendorId === '') {
+    return false;
+  }
+
+  if (normalizeVendorId(event?.subject?.id) === normalizedVendorId) {
+    return true;
+  }
+
+  if (typeof event?.payload?.vendorId === 'string') {
+    return normalizeVendorId(event.payload.vendorId) === normalizedVendorId;
+  }
+
+  return false;
+}
+
+export function selectVendorHistory(events, requestEvent) {
+  if (!Array.isArray(events)) {
+    return [];
+  }
+
+  const normalizedVendorId = normalizeVendorId(requestEvent?.payload?.vendorId);
+  const requestIndex = events.findIndex((event) => event?.id === requestEvent?.id);
+  const effectiveRequestIndex = requestIndex === -1 ? events.length : requestIndex;
+
+  return events
+    .map((event, index) => ({ event, index }))
+    .filter(({ event, index }) => {
+      if (!event || typeof event !== 'object' || Array.isArray(event)) {
+        return false;
+      }
+      if (event.id === requestEvent?.id) {
+        return false;
+      }
+      if (!eventPredatesRequest(event, index, requestEvent, effectiveRequestIndex)) {
+        return false;
+      }
+      return matchesVendor(normalizedVendorId, event);
+    })
+    .sort((left, right) => {
+      const timeDelta = Date.parse(right.event.occurredAt) - Date.parse(left.event.occurredAt);
+      if (timeDelta !== 0) {
+        return timeDelta;
+      }
+      return right.index - left.index;
+    })
+    .slice(0, 20)
+    .map(({ event }) => event);
+}
+
+function stripMarkdownFence(rawText) {
+  const trimmed = rawText.trim();
+  const fenced = trimmed.match(/^```(?:json)?\s*([\s\S]*?)\s*```$/i);
+  return fenced ? fenced[1].trim() : trimmed;
+}
+
+export function parseAssessmentJson(rawText) {
+  if (typeof rawText !== 'string' || rawText.trim() === '') {
+    throw new Error(`${ROLE_NAME} returned empty output`);
+  }
+
+  const normalizedText = stripMarkdownFence(rawText);
+  if (normalizedText === '') {
+    throw new Error(`${ROLE_NAME} returned empty output`);
+  }
+
+  try {
+    return JSON.parse(normalizedText);
+  } catch (error) {
+    throw new Error(`${ROLE_NAME} returned invalid JSON: ${error.message}`);
+  }
+}
+
+function isPlainObject(value) {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) {
+    return false;
+  }
+  return Object.getPrototypeOf(value) === Object.prototype;
+}
+
+export function normalizeAssessment(parsed, allowedEvidenceIds) {
+  const errors = [];
+
+  if (!isPlainObject(parsed)) {
+    throw new Error('Invalid risk assessment:\n- assessment: must be a plain object');
+  }
+
+  const keys = Object.keys(parsed);
+  const extraKeys = keys.filter((key) => !ASSESSMENT_KEYS.includes(key));
+  const missingKeys = ASSESSMENT_KEYS.filter((key) => !Object.hasOwn(parsed, key));
+  if (extraKeys.length > 0) {
+    errors.push(`assessment: extra keys are not allowed (${extraKeys.join(', ')})`);
+  }
+  if (missingKeys.length > 0) {
+    errors.push(`assessment: missing required keys (${missingKeys.join(', ')})`);
+  }
+
+  if (!ASSESSMENT_VERDICTS.has(parsed.verdict)) {
+    errors.push('verdict: must be one of "HOLD", "APPROVE", or "CHECK"');
+  }
+
+  if (typeof parsed.reasoning !== 'string' || parsed.reasoning.trim() === '') {
+    errors.push('reasoning: must be a non-empty string');
+  }
+
+  if (!Array.isArray(parsed.riskFactors)) {
+    errors.push('riskFactors: must be an array');
+  } else {
+    parsed.riskFactors.forEach((factor, index) => {
+      if (typeof factor !== 'string' || factor.trim() === '') {
+        errors.push(`riskFactors[${index}]: must be a non-empty string`);
+      }
+    });
+  }
+
+  const allowedIds = allowedEvidenceIds instanceof Set ? allowedEvidenceIds : new Set(allowedEvidenceIds ?? []);
+  let normalizedEvidenceIds = [];
+  if (!Array.isArray(parsed.evidenceEventIds)) {
+    errors.push('evidenceEventIds: must be an array');
+  } else {
+    const seen = new Set();
+    normalizedEvidenceIds = parsed.evidenceEventIds.map((value, index) => {
+      if (typeof value !== 'string') {
+        errors.push(`evidenceEventIds[${index}]: must be a non-empty string`);
+        return value;
+      }
+
+      const normalized = value.trim();
+      if (normalized === '') {
+        errors.push(`evidenceEventIds[${index}]: must be a non-empty string`);
+        return normalized;
+      }
+      if (seen.has(normalized)) {
+        errors.push(`evidenceEventIds[${index}]: duplicate evidence id "${normalized}"`);
+      } else {
+        seen.add(normalized);
+      }
+      if (!allowedIds.has(normalized)) {
+        errors.push(`evidenceEventIds[${index}]: unknown evidence id "${normalized}"`);
+      }
+      return normalized;
+    });
+  }
+
+  if (errors.length > 0) {
+    throw new Error(`Invalid risk assessment:\n- ${errors.join('\n- ')}`);
+  }
+
+  return {
+    verdict: parsed.verdict,
+    reasoning: parsed.reasoning.trim(),
+    riskFactors: parsed.riskFactors.map((factor) => factor.trim()),
+    evidenceEventIds: normalizedEvidenceIds
+  };
+}
