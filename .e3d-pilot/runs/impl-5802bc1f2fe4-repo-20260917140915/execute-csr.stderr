+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { AUTHORITY_LEVELS, getRequiredAuthorityLevel } from '../lib/authority/policy.js';
+import {
+  normalizeVendorId,
+  normalizeAssessment,
