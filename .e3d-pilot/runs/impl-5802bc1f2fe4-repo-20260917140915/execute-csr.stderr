+  }
+
+  const normalizedText = stripMarkdownFence(rawText);
+  if (normalizedText === '') {
+    throw new Error(`${ROLE_NAME} returned empty output`);
+  }
+
+  try {
+    return JSON.parse(normalizedText);
+  } catch (error) {
+    throw new Error(`${ROLE_NAME} returned invalid JSON: ${error.message}`);
+  }
+}
+
+function isPlainObject(value) {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) {
+    return false;
+  }
+  return Object.getPrototypeOf(value) === Object.prototype;
+}
+
+export function normalizeAssessment(parsed, allowedEvidenceIds) {
+  const errors = [];
+
+  if (!isPlainObject(parsed)) {
+    throw new Error('Invalid risk assessment:\n- assessment: must be a plain object');
+  }
+
+  const keys = Object.keys(parsed);
+  const extraKeys = keys.filter((key) => !ASSESSMENT_KEYS.includes(key));
+  const missingKeys = ASSESSMENT_KEYS.filter((key) => !Object.hasOwn(parsed, key));
+  if (extraKeys.length > 0) {
+    errors.push(`assessment: extra keys are not allowed (${extraKeys.join(', ')})`);
+  }
+  if (missingKeys.length > 0) {
+    errors.push(`assessment: missing required keys (${missingKeys.join(', ')})`);
+  }
+
+  if (!ASSESSMENT_VERDICTS.has(parsed.verdict)) {
+    errors.push('verdict: must be one of "HOLD", "APPROVE", or "CHECK"');
+  }
+
+  if (typeof parsed.reasoning !== 'string' || parsed.reasoning.trim() === '') {
+    errors.push('reasoning: must be a non-empty string');
+  }
+
+  if (!Array.isArray(parsed.riskFactors)) {
+    errors.push('riskFactors: must be an array');
+  } else {
+    parsed.riskFactors.forEach((factor, index) => {
+      if (typeof factor !== 'string' || factor.trim() === '') {
+        errors.push(`riskFactors[${index}]: must be a non-empty string`);
+      }
+    });
+  }
+
+  const allowedIds = allowedEvidenceIds instanceof Set ? allowedEvidenceIds : new Set(allowedEvidenceIds ?? []);
+  let normalizedEvidenceIds = [];
+  if (!Array.isArray(parsed.evidenceEventIds)) {
+    errors.push('evidenceEventIds: must be an array');
+  } else {
+    const seen = new Set();
+    normalizedEvidenceIds = parsed.evidenceEventIds.map((value, index) => {
+      if (typeof value !== 'string') {
+        errors.push(`evidenceEventIds[${index}]: must be a non-empty string`);
+        return value;
+      }
+
+      const normalized = value.trim();
+      if (normalized === '') {
+        errors.push(`evidenceEventIds[${index}]: must be a non-empty string`);
+        return normalized;
+      }
+      if (seen.has(normalized)) {
+        errors.push(`evidenceEventIds[${index}]: duplicate evidence id "${normalized}"`);
+      } else {
+        seen.add(normalized);
+      }
+      if (!allowedIds.has(normalized)) {
+        errors.push(`evidenceEventIds[${index}]: unknown evidence id "${normalized}"`);
+      }
+      return normalized;
+    });
+  }
+
+  if (errors.length > 0) {
+    throw new Error(`Invalid risk assessment:\n- ${errors.join('\n- ')}`);
+  }
+
+  return {
+    verdict: parsed.verdict,
+    reasoning: parsed.reasoning.trim(),
+    riskFactors: parsed.riskFactors.map((factor) => factor.trim()),
+    evidenceEventIds: normalizedEvidenceIds
+  };
+}
