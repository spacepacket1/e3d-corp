diff --git a/test/riskAssess.test.js b/test/riskAssess.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..772d47f0f5854897f2fb620962c086dfb74e28c6
--- /dev/null
+++ b/test/riskAssess.test.js
@@ -0,0 +1,206 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { AUTHORITY_LEVELS, getRequiredAuthorityLevel } from '../lib/authority/policy.js';
+import {
+  normalizeVendorId,
+  normalizeAssessment,
+  parseAssessmentJson,
+  selectVendorHistory
+} from '../lib/roles/riskAssess.js';
+
+function event({
+  id,
+  occurredAt,
+  subjectId = `subject-${id}`,
+  payload = {},
+  type = 'test.event'
+}) {
+  return {
+    id,
+    type,
+    occurredAt,
+    source: 'test',
+    subject: { type: 'test-subject', id: subjectId },
+    payload,
+    correlationId: `corr-${id}`
+  };
+}
+
+test('flag-payment-request resolves to authority level 3', () => {
+  assert.equal(getRequiredAuthorityLevel('flag-payment-request'), AUTHORITY_LEVELS.FINANCIAL_ACTION);
+});
+
+test('normalizeVendorId trims and lowercases vendor identifiers', () => {
+  assert.equal(normalizeVendorId('  ACME-PAY  '), 'acme-pay');
+  assert.equal(normalizeVendorId(''), '');
+  assert.equal(normalizeVendorId(null), '');
+});
+
+test('parseAssessmentJson strips markdown fences and normalizeAssessment accepts all verdicts with empty arrays', () => {
+  const allowedEvidenceIds = new Set(['request-1', 'history-1']);
+  const cases = [
+    { verdict: 'HOLD', reasoning: '  Hold for review.  ', riskFactors: ['  vendor mismatch  '], evidenceEventIds: [' request-1 '] },
+    { verdict: 'APPROVE', reasoning: '  History is consistent. ', riskFactors: [], evidenceEventIds: [] },
+    { verdict: 'CHECK', reasoning: '  Need another invoice copy. ', riskFactors: ['  missing backup '], evidenceEventIds: [' history-1 '] }
+  ];
+
+  for (const assessment of cases) {
+    const parsed = parseAssessmentJson('```json\n' + JSON.stringify(assessment, null, 2) + '\n```');
+    const normalized = normalizeAssessment(parsed, allowedEvidenceIds);
+    assert.equal(normalized.verdict, assessment.verdict);
+    assert.equal(normalized.reasoning, assessment.reasoning.trim());
+    assert.deepEqual(normalized.riskFactors, assessment.riskFactors.map((factor) => factor.trim()));
+    assert.deepEqual(
+      normalized.evidenceEventIds,
+      assessment.evidenceEventIds.map((evidenceId) => evidenceId.trim())
+    );
+  }
+});
+
+test('parseAssessmentJson rejects malformed or empty output', () => {
+  assert.throws(() => parseAssessmentJson(''), /returned empty output/);
+  assert.throws(() => parseAssessmentJson('```json\n```'), /returned empty output/);
+  assert.throws(() => parseAssessmentJson('```json\nnot json\n```'), /invalid JSON/);
+});
+
+test('normalizeAssessment rejects extra keys, invalid verdicts, missing fields, blank risk factors, duplicate citations, and fabricated evidence ids', () => {
+  const allowedEvidenceIds = new Set(['request-1', 'history-1']);
+  const valid = {
+    verdict: 'HOLD',
+    reasoning: 'Review requested',
+    riskFactors: ['needs review'],
+    evidenceEventIds: ['request-1']
+  };
+
+  assert.throws(
+    () => normalizeAssessment({ ...valid, extra: true }, allowedEvidenceIds),
+    /extra keys are not allowed/
+  );
+  assert.throws(
+    () => normalizeAssessment({ ...valid, verdict: 'DENY' }, allowedEvidenceIds),
+    /must be one of "HOLD", "APPROVE", or "CHECK"/
+  );
+  assert.throws(
+    () => normalizeAssessment({ verdict: 'HOLD', reasoning: 'x', riskFactors: [] }, allowedEvidenceIds),
+    /missing required keys/
+  );
+  assert.throws(
+    () => normalizeAssessment({ ...valid, riskFactors: ['   '] }, allowedEvidenceIds),
+    /riskFactors\[0\]: must be a non-empty string/
+  );
+  assert.throws(
+    () => normalizeAssessment({ ...valid, evidenceEventIds: ['request-1', ' request-1 '] }, allowedEvidenceIds),
+    /duplicate evidence id "request-1"/
+  );
+  assert.throws(
+    () => normalizeAssessment({ ...valid, evidenceEventIds: ['history-2'] }, allowedEvidenceIds),
+    /unknown evidence id "history-2"/
+  );
+});
+
+test('selectVendorHistory matches exact normalized vendor ids via subject.id and payload.vendorId, excludes unrelated events and the request itself', () => {
+  const requestEvent = event({
+    id: 'request-1',
+    occurredAt: '2026-09-18T10:00:00.000Z',
+    subjectId: 'payment-request-1',
+    payload: { vendorId: '  Acme-Pay ' },
+    type: 'payment-request.received'
+  });
+  const events = [
+    event({ id: 'older-subject', occurredAt: '2026-09-18T09:00:00.000Z', subjectId: ' acme-pay ' }),
+    event({
+      id: 'older-payload',
+      occurredAt: '2026-09-18T09:30:00.000Z',
+      subjectId: 'unrelated',
+      payload: { vendorId: 'ACME-PAY' }
+    }),
+    event({
+      id: 'other-vendor',
+      occurredAt: '2026-09-18T09:45:00.000Z',
+      subjectId: 'other-vendor',
+      payload: { vendorId: 'other-vendor' }
+    }),
+    requestEvent,
+    event({
+      id: 'future-match',
+      occurredAt: '2026-09-18T10:05:00.000Z',
+      subjectId: 'acme-pay'
+    })
+  ];
+
+  assert.deepEqual(
+    selectVendorHistory(events, requestEvent).map((entry) => entry.id),
+    ['older-payload', 'older-subject']
+  );
+});
+
+test('selectVendorHistory uses same-occurredAt log order, returns newest first, bounds to 20, and returns empty history when nothing matches', () => {
+  const sameTimeRequest = event({
+    id: 'request-same-time',
+    occurredAt: '2026-09-18T10:00:00.000Z',
+    subjectId: 'payment-request-same-time',
+    payload: { vendorId: 'vendor-42' },
+    type: 'payment-request.received'
+  });
+  const sameTimeEvents = [
+    event({
+      id: 'same-before',
+      occurredAt: '2026-09-18T10:00:00.000Z',
+      subjectId: 'before',
+      payload: { vendorId: 'vendor-42' }
+    }),
+    sameTimeRequest,
+    event({
+      id: 'same-after',
+      occurredAt: '2026-09-18T10:00:00.000Z',
+      subjectId: 'after',
+      payload: { vendorId: 'vendor-42' }
+    })
+  ];
+  assert.deepEqual(
+    selectVendorHistory(sameTimeEvents, sameTimeRequest).map((entry) => entry.id),
+    ['same-before']
+  );
+
+  const requestEvent = event({
+    id: 'request-2',
+    occurredAt: '2026-09-18T10:00:00.000Z',
+    subjectId: 'payment-request-2',
+    payload: { vendorId: 'vendor-42' },
+    type: 'payment-request.received'
+  });
+
+  const history = [];
+  for (let index = 0; index < 22; index += 1) {
+    history.push(
+      event({
+        id: `match-${index}`,
+        occurredAt: index >= 18 ? '2026-09-18T10:00:00.000Z' : `2026-09-18T09:${String(index).padStart(2, '0')}:00.000Z`,
+        subjectId: `vendor-${index}`,
+        payload: { vendorId: 'vendor-42' }
+      })
+    );
+  }
+  const other = event({
+    id: 'nope',
+    occurredAt: '2026-09-18T09:59:59.000Z',
+    subjectId: 'someone-else',
+    payload: { vendorId: 'someone-else' }
+  });
+
+  const events = [...history, other, requestEvent];
+  const selected = selectVendorHistory(events, requestEvent).map((entry) => entry.id);
+
+  assert.equal(selected.length, 20);
+  assert.deepEqual(selected.slice(0, 4), ['match-21', 'match-20', 'match-19', 'match-18']);
+  assert.deepEqual(selected.at(-1), 'match-2');
+
+  const emptyRequest = event({
+    id: 'request-3',
+    occurredAt: '2026-09-18T11:00:00.000Z',
+    subjectId: 'payment-request-3',
+    payload: { vendorId: 'vendor-missing' },
+    type: 'payment-request.received'
+  });
+  assert.deepEqual(selectVendorHistory([other, emptyRequest], emptyRequest), []);
+});

