+  );
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'x',
+          evidenceEventIds: []
+        },
+        allowedEvidenceIds
+      ),
+    /missing field/
+  );
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'x',
+          riskFactors: ['   '],
+          evidenceEventIds: []
+        },
+        allowedEvidenceIds
+      ),
+    /riskFactors\[0\] must not be blank/
+  );
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'x',
+          riskFactors: [],
+          evidenceEventIds: ['history-1', ' history-1 ']
+        },
+        allowedEvidenceIds
+      ),
+    /duplicate evidenceEventId/
+  );
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'CHECK',
+          reasoning: 'x',
+          riskFactors: [],
+          evidenceEventIds: ['invented-id']
+        },
+        allowedEvidenceIds
+      ),
+    /unknown evidenceEventId/
+  );
+});
+
+test('selectVendorHistory matches by normalized subject.id and payload.vendorId, excludes unrelated events and request itself, and keeps newest-first bounded order', () => {
