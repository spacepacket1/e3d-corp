diff --git a/lib/roles/riskAssess.js b/lib/roles/riskAssess.js
new file mode 100644
index 0000000000000000000000000000000000000000..e29eac79504033147795f814467abd9203d0f31f
--- /dev/null
+++ b/lib/roles/riskAssess.js
@@ -0,0 +1,178 @@
+const ALLOWED_VERDICTS = new Set(['HOLD', 'APPROVE', 'CHECK']);
+const REQUIRED_ASSESSMENT_KEYS = ['verdict', 'reasoning', 'riskFactors', 'evidenceEventIds'];
+
+export function normalizeVendorId(value) {
+  if (typeof value !== 'string') {
+    return null;
+  }
+
+  const normalized = value.trim().toLowerCase();
+  return normalized === '' ? null : normalized;
+}
+
+function eventTimestamp(event) {
+  return new Date(event?.occurredAt).getTime();
+}
+
+function isPlainObject(value) {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) {
+    return false;
+  }
+
+  const prototype = Object.getPrototypeOf(value);
+  return prototype === Object.prototype || prototype === null;
+}
+
+export function selectVendorHistory(events, requestEvent) {
+  const requestVendorId = normalizeVendorId(requestEvent?.payload?.vendorId);
+  if (!requestVendorId || !Array.isArray(events)) {
+    return [];
+  }
+
+  const requestIndex = events.findIndex((event) => event?.id === requestEvent?.id);
+  const requestTime = eventTimestamp(requestEvent);
+
+  return events
+    .map((event, index) => ({ event, index }))
+    .filter(({ event, index }) => {
+      if (!event || event.id === requestEvent?.id) {
+        return false;
+      }
+
+      const eventTime = eventTimestamp(event);
+      const predatesRequest =
+        eventTime < requestTime || (eventTime === requestTime && requestIndex !== -1 && index < requestIndex);
+      if (!predatesRequest) {
+        return false;
+      }
+
+      const subjectVendorId = normalizeVendorId(event.subject?.id);
+      const payloadVendorId =
+        typeof event.payload?.vendorId === 'string' ? normalizeVendorId(event.payload.vendorId) : null;
+
+      return requestVendorId === subjectVendorId || requestVendorId === payloadVendorId;
+    })
+    .sort((left, right) => {
+      const timeDifference = eventTimestamp(right.event) - eventTimestamp(left.event);
+      if (timeDifference !== 0) {
+        return timeDifference;
+      }
+      return right.index - left.index;
+    })
+    .slice(0, 20)
+    .map(({ event }) => event);
+}
+
+function stripMarkdownFence(rawText) {
+  const trimmed = rawText.trim();
+  const fenced = trimmed.match(/^```(?:json)?\s*([\s\S]*?)\s*```$/i);
+  return fenced ? fenced[1].trim() : trimmed;
+}
+
+export function parseAssessmentJson(rawText) {
+  if (typeof rawText !== 'string' || rawText.trim() === '') {
+    throw new Error('risk.assess returned empty output');
+  }
+
+  try {
+    return JSON.parse(stripMarkdownFence(rawText));
+  } catch (error) {
+    throw new Error(`risk.assess returned invalid JSON: ${error.message}`);
+  }
+}
+
+function validateAssessmentKeys(parsed) {
+  const keys = Object.keys(parsed);
+  const unexpectedKeys = keys.filter((key) => !REQUIRED_ASSESSMENT_KEYS.includes(key));
+  if (unexpectedKeys.length > 0) {
+    throw new Error(`Invalid assessment: unexpected field(s): ${unexpectedKeys.join(', ')}`);
+  }
+
+  const missingKeys = REQUIRED_ASSESSMENT_KEYS.filter((key) => !Object.prototype.hasOwnProperty.call(parsed, key));
+  if (missingKeys.length > 0) {
+    throw new Error(`Invalid assessment: missing field(s): ${missingKeys.join(', ')}`);
+  }
+
+  if (keys.length !== REQUIRED_ASSESSMENT_KEYS.length) {
+    throw new Error('Invalid assessment: must contain exactly the required fields');
+  }
+}
+
+function normalizeRiskFactors(riskFactors) {
+  if (!Array.isArray(riskFactors)) {
+    throw new Error('Invalid assessment: riskFactors must be an array');
+  }
+
+  return riskFactors.map((riskFactor, index) => {
+    if (typeof riskFactor !== 'string') {
+      throw new Error(`Invalid assessment: riskFactors[${index}] must be a string`);
+    }
+
+    const normalized = riskFactor.trim();
+    if (normalized === '') {
+      throw new Error(`Invalid assessment: riskFactors[${index}] must not be blank`);
+    }
+
+    return normalized;
+  });
+}
+
+function normalizeEvidenceEventIds(evidenceEventIds, allowedEvidenceIds) {
+  if (!Array.isArray(evidenceEventIds)) {
+    throw new Error('Invalid assessment: evidenceEventIds must be an array');
+  }
+
+  const normalizedIds = [];
+  const seen = new Set();
+
+  evidenceEventIds.forEach((evidenceEventId, index) => {
+    if (typeof evidenceEventId !== 'string') {
+      throw new Error(`Invalid assessment: evidenceEventIds[${index}] must be a string`);
+    }
+
+    const normalized = evidenceEventId.trim();
+    if (normalized === '') {
+      throw new Error(`Invalid assessment: evidenceEventIds[${index}] must not be blank`);
+    }
+    if (seen.has(normalized)) {
+      throw new Error(`Invalid assessment: duplicate evidenceEventId "${normalized}"`);
+    }
+    if (!allowedEvidenceIds.has(normalized)) {
+      throw new Error(`Invalid assessment: unknown evidenceEventId "${normalized}"`);
+    }
+
+    seen.add(normalized);
+    normalizedIds.push(normalized);
+  });
+
+  return normalizedIds;
+}
+
+export function normalizeAssessment(parsed, allowedEvidenceIds) {
+  if (!isPlainObject(parsed)) {
+    throw new Error('Invalid assessment: must be a plain object');
+  }
+
+  validateAssessmentKeys(parsed);
+
+  if (!ALLOWED_VERDICTS.has(parsed.verdict)) {
+    throw new Error('Invalid assessment: verdict must be one of HOLD, APPROVE, CHECK');
+  }
+  if (typeof parsed.reasoning !== 'string') {
+    throw new Error('Invalid assessment: reasoning must be a string');
+  }
+
+  const reasoning = parsed.reasoning.trim();
+  if (reasoning === '') {
+    throw new Error('Invalid assessment: reasoning must not be blank');
+  }
+
+  const allowedSet = allowedEvidenceIds instanceof Set ? allowedEvidenceIds : new Set(allowedEvidenceIds);
+
+  return {
+    verdict: parsed.verdict,
+    reasoning,
+    riskFactors: normalizeRiskFactors(parsed.riskFactors),
+    evidenceEventIds: normalizeEvidenceEventIds(parsed.evidenceEventIds, allowedSet)
+  };
+}
