+
+  if (keys.length !== REQUIRED_ASSESSMENT_KEYS.length) {
+    throw new Error('Invalid assessment: must contain exactly the required fields');
+  }
+}
+
+function normalizeRiskFactors(riskFactors) {
+  if (!Array.isArray(riskFactors)) {
+    throw new Error('Invalid assessment: riskFactors must be an array');
+  }
+
+  return riskFactors.map((riskFactor, index) => {
+    if (typeof riskFactor !== 'string') {
+      throw new Error(`Invalid assessment: riskFactors[${index}] must be a string`);
+    }
+
+    const normalized = riskFactor.trim();
+    if (normalized === '') {
+      throw new Error(`Invalid assessment: riskFactors[${index}] must not be blank`);
+    }
+
+    return normalized;
+  });
+}
+
+function normalizeEvidenceEventIds(evidenceEventIds, allowedEvidenceIds) {
+  if (!Array.isArray(evidenceEventIds)) {
+    throw new Error('Invalid assessment: evidenceEventIds must be an array');
+  }
+
+  const normalizedIds = [];
+  const seen = new Set();
+
+  evidenceEventIds.forEach((evidenceEventId, index) => {
+    if (typeof evidenceEventId !== 'string') {
+      throw new Error(`Invalid assessment: evidenceEventIds[${index}] must be a string`);
+    }
+
+    const normalized = evidenceEventId.trim();
+    if (normalized === '') {
+      throw new Error(`Invalid assessment: evidenceEventIds[${index}] must not be blank`);
+    }
+    if (seen.has(normalized)) {
+      throw new Error(`Invalid assessment: duplicate evidenceEventId "${normalized}"`);
+    }
+    if (!allowedEvidenceIds.has(normalized)) {
+      throw new Error(`Invalid assessment: unknown evidenceEventId "${normalized}"`);
+    }
+
+    seen.add(normalized);
+    normalizedIds.push(normalized);
+  });
+
+  return normalizedIds;
+}
+
+export function normalizeAssessment(parsed, allowedEvidenceIds) {
+  if (!isPlainObject(parsed)) {
+    throw new Error('Invalid assessment: must be a plain object');
+  }
+
+  validateAssessmentKeys(parsed);
+
+  if (!ALLOWED_VERDICTS.has(parsed.verdict)) {
+    throw new Error('Invalid assessment: verdict must be one of HOLD, APPROVE, CHECK');
+  }
+  if (typeof parsed.reasoning !== 'string') {
+    throw new Error('Invalid assessment: reasoning must be a string');
+  }
+
+  const reasoning = parsed.reasoning.trim();
+  if (reasoning === '') {
+    throw new Error('Invalid assessment: reasoning must not be blank');
+  }
+
+  const allowedSet = allowedEvidenceIds instanceof Set ? allowedEvidenceIds : new Set(allowedEvidenceIds);
+
+  return {
+    verdict: parsed.verdict,
+    reasoning,
+    riskFactors: normalizeRiskFactors(parsed.riskFactors),
+    evidenceEventIds: normalizeEvidenceEventIds(parsed.evidenceEventIds, allowedSet)
+  };
+}
diff --git a/test/riskAssess.test.js b/test/riskAssess.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..5a2f783d5813a80ec72861050088648e9d3076c3
--- /dev/null
+++ b/test/riskAssess.test.js
@@ -0,0 +1,265 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { AUTHORITY_LEVELS, getRequiredAuthorityLevel } from '../lib/authority/policy.js';
+import {
+  normalizeAssessment,
+  normalizeVendorId,
+  parseAssessmentJson,
+  selectVendorHistory
+} from '../lib/roles/riskAssess.js';
+
+function makeEvent({ id, occurredAt, subjectId = 'subject', payloadVendorId, payload = {} }) {
+  return {
+    id,
+    occurredAt,
+    subject: { type: 'vendor', id: subjectId },
+    payload: payloadVendorId === undefined ? payload : { ...payload, vendorId: payloadVendorId }
+  };
+}
+
+test('normalizeVendorId trims and lowercases vendor ids', () => {
+  assert.equal(normalizeVendorId('  Acme-Vendor  '), 'acme-vendor');
+  assert.equal(normalizeVendorId('   '), null);
+  assert.equal(normalizeVendorId(null), null);
+});
+
+test('parseAssessmentJson strips markdown fences and normalizeAssessment accepts all verdicts with normalized fields', () => {
+  const allowedEvidenceIds = new Set(['request-1', 'history-1', 'history-2']);
+  const approveRaw = '```json\n{"verdict":"APPROVE","reasoning":"  Looks routine.  ","riskFactors":[],"evidenceEventIds":[]}\n```';
+  const holdRaw = '{"verdict":"HOLD","reasoning":"  Investigate duplicate invoice. ","riskFactors":["  duplicate invoice number  "],"evidenceEventIds":[" request-1 "," history-1 "]}';
+  const checkRaw = '{"verdict":"CHECK","reasoning":" Need one more confirmation ","riskFactors":["  mismatched due date  "],"evidenceEventIds":["history-2"]}';
+
+  assert.deepEqual(normalizeAssessment(parseAssessmentJson(approveRaw), allowedEvidenceIds), {
+    verdict: 'APPROVE',
+    reasoning: 'Looks routine.',
+    riskFactors: [],
+    evidenceEventIds: []
+  });
+  assert.deepEqual(normalizeAssessment(parseAssessmentJson(holdRaw), allowedEvidenceIds), {
+    verdict: 'HOLD',
+    reasoning: 'Investigate duplicate invoice.',
+    riskFactors: ['duplicate invoice number'],
+    evidenceEventIds: ['request-1', 'history-1']
+  });
+  assert.deepEqual(normalizeAssessment(parseAssessmentJson(checkRaw), allowedEvidenceIds), {
+    verdict: 'CHECK',
+    reasoning: 'Need one more confirmation',
+    riskFactors: ['mismatched due date'],
+    evidenceEventIds: ['history-2']
+  });
+});
+
+test('assessment parsing and normalization reject malformed schema variants', () => {
+  const allowedEvidenceIds = new Set(['request-1', 'history-1']);
+
+  assert.throws(() => parseAssessmentJson(''), /empty output/);
+  assert.throws(() => parseAssessmentJson('```json\nnot json\n```'), /invalid JSON/);
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'APPROVE',
+          reasoning: 'ok',
+          riskFactors: [],
+          evidenceEventIds: [],
+          extra: true
+        },
+        allowedEvidenceIds
+      ),
+    /unexpected field/
+  );
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'DENY',
+          reasoning: 'no',
+          riskFactors: [],
+          evidenceEventIds: []
+        },
+        allowedEvidenceIds
+      ),
+    /verdict must be one of/
+  );
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'x',
+          evidenceEventIds: []
+        },
+        allowedEvidenceIds
+      ),
+    /missing field/
+  );
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'x',
+          riskFactors: ['   '],
+          evidenceEventIds: []
+        },
+        allowedEvidenceIds
+      ),
+    /riskFactors\[0\] must not be blank/
+  );
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'x',
+          riskFactors: [],
+          evidenceEventIds: ['history-1', ' history-1 ']
+        },
+        allowedEvidenceIds
+      ),
+    /duplicate evidenceEventId/
+  );
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'CHECK',
+          reasoning: 'x',
+          riskFactors: [],
+          evidenceEventIds: ['invented-id']
+        },
+        allowedEvidenceIds
+      ),
+    /unknown evidenceEventId/
+  );
+});
+
+test('selectVendorHistory matches by normalized subject.id and payload.vendorId, excludes unrelated events and request itself, and keeps newest-first bounded order', () => {
+  const requestEvent = makeEvent({
+    id: 'request-1',
+    occurredAt: '2026-09-18T12:00:00.000Z',
+    subjectId: 'payment-request',
+    payloadVendorId: ' vendor-42 '
+  });
+
+  const olderRelevant = Array.from({ length: 23 }, (_value, index) =>
+    makeEvent({
+      id: `history-${index}`,
+      occurredAt: `2026-09-18T11:${String(index).padStart(2, '0')}:00.000Z`,
+      subjectId: index % 2 === 0 ? ' VENDOR-42 ' : `other-subject-${index}`,
+      payloadVendorId: index % 2 === 0 ? undefined : 'vendor-42'
+    })
+  );
+
+  const unrelated = [
+    makeEvent({
+      id: 'unrelated-subject',
+      occurredAt: '2026-09-18T11:59:58.000Z',
+      subjectId: 'vendor-420',
+      payloadVendorId: 'vendor-420'
+    }),
+    makeEvent({
+      id: 'unrelated-payload',
+      occurredAt: '2026-09-18T11:59:57.000Z',
+      subjectId: 'vendor-77',
+      payloadVendorId: 'vendor-77'
+    })
+  ];
+
+  const events = [...olderRelevant, ...unrelated, requestEvent];
+  const history = selectVendorHistory(events, requestEvent);
+
+  assert.equal(history.length, 20);
+  assert.deepEqual(
+    history.map((event) => event.id),
+    [
+      'history-22',
+      'history-21',
+      'history-20',
+      'history-19',
+      'history-18',
+      'history-17',
+      'history-16',
+      'history-15',
+      'history-14',
+      'history-13',
+      'history-12',
+      'history-11',
+      'history-10',
+      'history-9',
+      'history-8',
+      'history-7',
+      'history-6',
+      'history-5',
+      'history-4',
+      'history-3'
+    ]
+  );
+  assert.equal(history.some((event) => event.id === requestEvent.id), false);
+  assert.equal(history.some((event) => event.id.startsWith('unrelated')), false);
+});
+
+test('selectVendorHistory treats same-occurredAt earlier log entries as prior history and ignores later same-timestamp entries', () => {
+  const requestEvent = makeEvent({
+    id: 'request-same-time',
+    occurredAt: '2026-09-18T12:00:00.000Z',
+    subjectId: 'payment-request',
+    payloadVendorId: 'vendor-7'
+  });
+  const events = [
+    makeEvent({
+      id: 'earliest',
+      occurredAt: '2026-09-18T11:59:59.000Z',
+      subjectId: 'vendor-7'
+    }),
+    makeEvent({
+      id: 'same-time-earlier',
+      occurredAt: '2026-09-18T12:00:00.000Z',
+      payloadVendorId: ' vendor-7 '
+    }),
+    requestEvent,
+    makeEvent({
+      id: 'same-time-later',
+      occurredAt: '2026-09-18T12:00:00.000Z',
+      subjectId: 'vendor-7'
+    }),
+    makeEvent({
+      id: 'later',
+      occurredAt: '2026-09-18T12:00:01.000Z',
+      payloadVendorId: 'vendor-7'
+    })
+  ];
+
+  assert.deepEqual(
+    selectVendorHistory(events, requestEvent).map((event) => event.id),
+    ['same-time-earlier', 'earliest']
+  );
+});
+
+test('selectVendorHistory returns an empty array when there is no prior matching vendor history', () => {
+  const requestEvent = makeEvent({
+    id: 'request-empty',
+    occurredAt: '2026-09-18T12:00:00.000Z',
+    subjectId: 'payment-request',
+    payloadVendorId: 'vendor-empty'
+  });
+  const events = [
+    makeEvent({
+      id: 'future-match',
+      occurredAt: '2026-09-18T12:00:01.000Z',
+      subjectId: 'vendor-empty'
+    }),
+    requestEvent,
+    makeEvent({
+      id: 'other-vendor',
+      occurredAt: '2026-09-18T11:59:00.000Z',
+      subjectId: 'vendor-other'
+    })
+  ];
+
+  assert.deepEqual(selectVendorHistory(events, requestEvent), []);
+});
+
+test('flag-payment-request resolves to financial authority level 3', () => {
+  assert.equal(getRequiredAuthorityLevel('flag-payment-request'), AUTHORITY_LEVELS.FINANCIAL_ACTION);
+});

  ✓ Update authority policy for flag-payment-request and bump policy version
  ✓ Add Phase 1 riskAssess helper module with vendor normalization/history selection and assessment parsing/normalization
  ✓ Add focused Phase 1 tests for policy and helper behavior
  → Run npm install and npm run check, then write the handoff summary
