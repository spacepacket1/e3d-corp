diff --git a/lib/roles/riskAssess.js b/lib/roles/riskAssess.js
new file mode 100644
index 0000000000000000000000000000000000000000..b3f4ee55f6e94d38453f262e22c6c06428299904
--- /dev/null
+++ b/lib/roles/riskAssess.js
@@ -0,0 +1,162 @@
+const ROLE_NAME = 'risk.assess';
+
+const ASSESSMENT_KEYS = ['verdict', 'reasoning', 'riskFactors', 'evidenceEventIds'];
+const ASSESSMENT_KEY_SET = new Set(ASSESSMENT_KEYS);
+const VALID_VERDICTS = new Set(['HOLD', 'APPROVE', 'CHECK']);
+
+function stripMarkdownFence(rawText) {
+  const trimmed = rawText.trim();
+  const fenced = trimmed.match(/^```(?:json)?\s*([\s\S]*?)\s*```$/i);
+  return fenced ? fenced[1].trim() : trimmed;
+}
+
+function isPlainObject(value) {
+  return value !== null && typeof value === 'object' && !Array.isArray(value) && Object.getPrototypeOf(value) === Object.prototype;
+}
+
+function normalizeTrimmedString(value, fieldName) {
+  if (typeof value !== 'string') {
+    throw new Error(`${fieldName}: must be a string`);
+  }
+
+  const normalized = value.trim();
+  if (normalized === '') {
+    throw new Error(`${fieldName}: must be a non-empty string`);
+  }
+
+  return normalized;
+}
+
+function normalizeStringArray(values, fieldName) {
+  if (!Array.isArray(values)) {
+    throw new Error(`${fieldName}: must be an array`);
+  }
+
+  return values.map((value, index) => normalizeTrimmedString(value, `${fieldName}[${index}]`));
+}
+
+function toAllowedEvidenceIdSet(allowedEvidenceIds) {
+  if (allowedEvidenceIds instanceof Set) {
+    return allowedEvidenceIds;
+  }
+  return new Set(allowedEvidenceIds);
+}
+
+function getLogIndex(events, eventId) {
+  return events.findIndex((event) => event?.id === eventId);
+}
+
+function eventTime(event) {
+  return Date.parse(event?.occurredAt ?? '');
+}
+
+function predatesRequestEvent(event, eventIndex, requestEvent, requestIndex) {
+  const candidateTime = eventTime(event);
+  const requestTime = eventTime(requestEvent);
+
+  if (candidateTime < requestTime) {
+    return true;
+  }
+  if (candidateTime > requestTime) {
+    return false;
+  }
+
+  return requestIndex !== -1 && eventIndex < requestIndex;
+}
+
+export function normalizeVendorId(value) {
+  if (typeof value !== 'string') {
+    return null;
+  }
+
+  return value.trim().toLowerCase();
+}
+
+export function selectVendorHistory(events, requestEvent) {
+  const requestVendorId = normalizeVendorId(requestEvent?.payload?.vendorId);
+  const requestIndex = getLogIndex(events, requestEvent?.id);
+
+  return events
+    .map((event, index) => ({ event, index }))
+    .filter(({ event, index }) => {
+      if (!requestVendorId) {
+        return false;
+      }
+      if (event?.id === requestEvent?.id) {
+        return false;
+      }
+      if (!predatesRequestEvent(event, index, requestEvent, requestIndex)) {
+        return false;
+      }
+
+      const subjectVendorId = normalizeVendorId(event?.subject?.id);
+      const payloadVendorId =
+        typeof event?.payload?.vendorId === 'string' ? normalizeVendorId(event.payload.vendorId) : null;
+
+      return requestVendorId === subjectVendorId || requestVendorId === payloadVendorId;
+    })
+    .sort((left, right) => {
+      const timeDelta = eventTime(right.event) - eventTime(left.event);
+      if (timeDelta !== 0) {
+        return timeDelta;
+      }
+      return right.index - left.index;
+    })
+    .slice(0, 20)
+    .map(({ event }) => event);
+}
+
+export function parseAssessmentJson(rawText) {
+  if (typeof rawText !== 'string' || rawText.trim() === '') {
+    throw new Error(`${ROLE_NAME} returned empty output`);
+  }
+
+  try {
+    return JSON.parse(stripMarkdownFence(rawText));
+  } catch (error) {
+    throw new Error(`${ROLE_NAME} returned invalid JSON: ${error.message}`);
+  }
+}
+
+export function normalizeAssessment(parsed, allowedEvidenceIds) {
+  if (!isPlainObject(parsed)) {
+    throw new Error('assessment: must be a plain object');
+  }
+
+  const keys = Object.keys(parsed);
+  if (keys.length !== ASSESSMENT_KEYS.length) {
+    throw new Error(`assessment: must contain exactly these keys: ${ASSESSMENT_KEYS.join(', ')}`);
+  }
+  for (const key of keys) {
+    if (!ASSESSMENT_KEY_SET.has(key)) {
+      throw new Error(`assessment: unexpected key "${key}"`);
+    }
+  }
+
+  if (!VALID_VERDICTS.has(parsed.verdict)) {
+    throw new Error('verdict: must be one of HOLD, APPROVE, CHECK');
+  }
+
+  const reasoning = normalizeTrimmedString(parsed.reasoning, 'reasoning');
+  const riskFactors = normalizeStringArray(parsed.riskFactors, 'riskFactors');
+  const normalizedEvidenceIds = normalizeStringArray(parsed.evidenceEventIds, 'evidenceEventIds');
+  const allowedEvidenceIdSet = toAllowedEvidenceIdSet(allowedEvidenceIds);
+  const seenEvidenceIds = new Set();
+
+  for (const evidenceId of normalizedEvidenceIds) {
+    if (seenEvidenceIds.has(evidenceId)) {
+      throw new Error(`evidenceEventIds: duplicate ID "${evidenceId}"`);
+    }
+    if (!allowedEvidenceIdSet.has(evidenceId)) {
+      throw new Error(`evidenceEventIds: unknown ID "${evidenceId}"`);
+    }
+    seenEvidenceIds.add(evidenceId);
+  }
+
+  return {
+    verdict: parsed.verdict,
+    reasoning,
+    riskFactors,
+    evidenceEventIds: normalizedEvidenceIds
+  };
+}
