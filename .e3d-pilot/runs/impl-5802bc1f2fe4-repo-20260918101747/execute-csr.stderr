diff --git a/test/riskAssess.test.js b/test/riskAssess.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..8a734b929bfcc1bf7ffab7b808dfe13b6233829f
--- /dev/null
+++ b/test/riskAssess.test.js
@@ -0,0 +1,296 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { AUTHORITY_LEVELS, getRequiredAuthorityLevel } from '../lib/authority/policy.js';
+import {
+  normalizeAssessment,
+  normalizeVendorId,
+  parseAssessmentJson,
+  selectVendorHistory
+} from '../lib/roles/riskAssess.js';
+
+function eventRecord({
+  id,
+  occurredAt,
+  subjectId = 'other-subject',
+  payloadVendorId,
+  type = 'event.recorded'
+}) {
+  const payload = {};
+  if (payloadVendorId !== undefined) {
+    payload.vendorId = payloadVendorId;
+  }
+
+  return {
+    id,
+    type,
+    occurredAt,
+    source: 'test',
+    subject: { type: 'vendor', id: subjectId },
+    payload,
+    correlationId: 'corr-risk-assess'
+  };
+}
+
+function paymentRequestEvent(overrides = {}) {
+  return {
+    id: 'request-1',
+    type: 'payment-request.received',
+    occurredAt: '2026-09-18T15:00:00.000Z',
+    source: 'cli',
+    subject: { type: 'payment-request', id: 'request-1' },
+    payload: {
+      requestId: 'request-1',
+      vendorId: 'vendor-123'
+    },
+    correlationId: 'corr-risk-assess',
+    ...overrides
+  };
+}
+
+test('normalizeVendorId trims surrounding whitespace and lowercases the value', () => {
+  assert.equal(normalizeVendorId('  Acme-VENDOR  '), 'acme-vendor');
+  assert.equal(normalizeVendorId(''), '');
+  assert.equal(normalizeVendorId(null), null);
+});
+
+test('parseAssessmentJson strips a wrapping markdown fence before parsing JSON', () => {
+  const parsed = parseAssessmentJson('```json\n{"verdict":"HOLD","reasoning":" review ","riskFactors":[],"evidenceEventIds":[]}\n```');
+  assert.equal(parsed.verdict, 'HOLD');
+  assert.equal(parsed.reasoning, ' review ');
+});
+
+test('parseAssessmentJson rejects empty output and malformed JSON', () => {
+  assert.throws(() => parseAssessmentJson('   '), /risk\.assess returned empty output/);
+  assert.throws(() => parseAssessmentJson('```json\n{"verdict":\n```'), /risk\.assess returned invalid JSON/);
+});
+
+test('normalizeAssessment accepts and normalizes HOLD, APPROVE, and CHECK verdicts', () => {
+  const allowedEvidenceIds = new Set(['request-1', 'event-1', 'event-2']);
+
+  assert.deepEqual(
+    normalizeAssessment(
+      {
+        verdict: 'HOLD',
+        reasoning: '  Missing invoice context.  ',
+        riskFactors: ['  overdue account  ', ' duplicate amount '],
+        evidenceEventIds: [' event-1 ', 'request-1']
+      },
+      allowedEvidenceIds
+    ),
+    {
+      verdict: 'HOLD',
+      reasoning: 'Missing invoice context.',
+      riskFactors: ['overdue account', 'duplicate amount'],
+      evidenceEventIds: ['event-1', 'request-1']
+    }
+  );
+
+  assert.deepEqual(
+    normalizeAssessment(
+      {
+        verdict: 'APPROVE',
+        reasoning: '  History is consistent. ',
+        riskFactors: [],
+        evidenceEventIds: []
+      },
+      allowedEvidenceIds
+    ),
+    {
+      verdict: 'APPROVE',
+      reasoning: 'History is consistent.',
+      riskFactors: [],
+      evidenceEventIds: []
+    }
+  );
+
+  assert.deepEqual(
+    normalizeAssessment(
+      {
+        verdict: 'CHECK',
+        reasoning: '  Need human review for timing. ',
+        riskFactors: [' same-day change '],
+        evidenceEventIds: [' event-2 ']
+      },
+      allowedEvidenceIds
+    ),
+    {
+      verdict: 'CHECK',
+      reasoning: 'Need human review for timing.',
+      riskFactors: ['same-day change'],
+      evidenceEventIds: ['event-2']
+    }
+  );
+});
+
+test('normalizeAssessment rejects extra keys, invalid verdicts, missing fields, blank risk factors, duplicate citations, and fabricated evidence IDs', () => {
+  const allowedEvidenceIds = new Set(['request-1', 'event-1']);
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'valid',
+          riskFactors: [],
+          evidenceEventIds: [],
+          extra: true
+        },
+        allowedEvidenceIds
+      ),
+    /exactly these keys|unexpected key/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'BLOCK',
+          reasoning: 'valid',
+          riskFactors: [],
+          evidenceEventIds: []
+        },
+        allowedEvidenceIds
+      ),
+    /must be one of HOLD, APPROVE, CHECK/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'valid',
+          riskFactors: []
+        },
+        allowedEvidenceIds
+      ),
+    /exactly these keys/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'valid',
+          riskFactors: ['   '],
+          evidenceEventIds: []
+        },
+        allowedEvidenceIds
+      ),
+    /riskFactors\[0\]: must be a non-empty string/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'valid',
+          riskFactors: [],
+          evidenceEventIds: ['event-1', ' event-1 ']
+        },
+        allowedEvidenceIds
+      ),
+    /duplicate ID "event-1"/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'valid',
+          riskFactors: [],
+          evidenceEventIds: ['made-up-id']
+        },
+        allowedEvidenceIds
+      ),
+    /unknown ID "made-up-id"/
+  );
+});
+
+test('selectVendorHistory matches prior events by normalized subject.id and payload.vendorId, excluding unrelated vendors and the request itself', () => {
+  const requestEvent = paymentRequestEvent();
+  const events = [
+    eventRecord({
+      id: 'older-subject-match',
+      occurredAt: '2026-09-18T14:00:00.000Z',
+      subjectId: ' Vendor-123 '
+    }),
+    eventRecord({
+      id: 'older-payload-match',
+      occurredAt: '2026-09-18T14:30:00.000Z',
+      subjectId: 'other-subject',
+      payloadVendorId: ' VENDOR-123 '
+    }),
+    eventRecord({
+      id: 'unrelated',
+      occurredAt: '2026-09-18T14:45:00.000Z',
+      subjectId: 'vendor-999',
+      payloadVendorId: 'vendor-999'
+    }),
+    requestEvent
+  ];
+
+  const selected = selectVendorHistory(events, requestEvent);
+  assert.deepEqual(
+    selected.map((event) => event.id),
+    ['older-payload-match', 'older-subject-match']
+  );
+});
+
+test('selectVendorHistory uses same-occurredAt log order for predating and returns newest first with a 20-event bound', () => {
+  const requestEvent = paymentRequestEvent({ id: 'request-20', occurredAt: '2026-09-18T15:00:00.000Z' });
+  const earlierSameTimestampBefore = eventRecord({
+    id: 'same-ts-before',
+    occurredAt: '2026-09-18T15:00:00.000Z',
+    payloadVendorId: 'vendor-123'
+  });
+  const sameTimestampAfter = eventRecord({
+    id: 'same-ts-after',
+    occurredAt: '2026-09-18T15:00:00.000Z',
+    payloadVendorId: 'vendor-123'
+  });
+
+  const olderMatches = Array.from({ length: 22 }, (_, index) =>
+    eventRecord({
+      id: `older-${index + 1}`,
+      occurredAt: `2026-09-18T14:${String(index).padStart(2, '0')}:00.000Z`,
+      payloadVendorId: 'vendor-123'
+    })
+  );
+
+  const events = [...olderMatches, earlierSameTimestampBefore, requestEvent, sameTimestampAfter];
+  const selected = selectVendorHistory(events, requestEvent);
+
+  assert.equal(selected.length, 20);
+  assert.equal(selected[0].id, 'same-ts-before');
+  assert.equal(selected[1].id, 'older-22');
+  assert.equal(selected[19].id, 'older-4');
+  assert.ok(!selected.some((event) => event.id === 'same-ts-after'));
+  assert.ok(!selected.some((event) => event.id === requestEvent.id));
+});
+
+test('selectVendorHistory returns an empty array when there is no prior matching vendor history', () => {
+  const requestEvent = paymentRequestEvent({ id: 'request-empty' });
+  const events = [
+    eventRecord({
+      id: 'future-match',
+      occurredAt: '2026-09-18T16:00:00.000Z',
+      payloadVendorId: 'vendor-123'
+    }),
+    requestEvent,
+    eventRecord({
+      id: 'other-vendor',
+      occurredAt: '2026-09-18T14:00:00.000Z',
+      payloadVendorId: 'vendor-999'
+    })
+  ];
+
+  assert.deepEqual(selectVendorHistory(events, requestEvent), []);
+});
+
+test('flag-payment-request resolves to financial authority level 3', () => {
+  assert.equal(getRequiredAuthorityLevel('flag-payment-request'), AUTHORITY_LEVELS.FINANCIAL_ACTION);
+});

