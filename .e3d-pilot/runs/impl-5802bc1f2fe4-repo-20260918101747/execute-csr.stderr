diff --git a/test/riskAssess.test.js b/test/riskAssess.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..8a734b929bfcc1bf7ffab7b808dfe13b6233829f
--- /dev/null
+++ b/test/riskAssess.test.js
@@ -0,0 +1,296 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { AUTHORITY_LEVELS, getRequiredAuthorityLevel } from '../lib/authority/policy.js';
+import {
+  normalizeAssessment,
+  normalizeVendorId,
+  parseAssessmentJson,
+  selectVendorHistory
+} from '../lib/roles/riskAssess.js';
+
+function eventRecord({
+  id,
+  occurredAt,
+  subjectId = 'other-subject',
+  payloadVendorId,
+  type = 'event.recorded'
+}) {
+  const payload = {};
+  if (payloadVendorId !== undefined) {
+    payload.vendorId = payloadVendorId;
+  }
+
+  return {
+    id,
+    type,
+    occurredAt,
+    source: 'test',
+    subject: { type: 'vendor', id: subjectId },
+    payload,
+    correlationId: 'corr-risk-assess'
+  };
+}
+
+function paymentRequestEvent(overrides = {}) {
+  return {
+    id: 'request-1',
+    type: 'payment-request.received',
+    occurredAt: '2026-09-18T15:00:00.000Z',
+    source: 'cli',
+    subject: { type: 'payment-request', id: 'request-1' },
+    payload: {
+      requestId: 'request-1',
+      vendorId: 'vendor-123'
+    },
+    correlationId: 'corr-risk-assess',
+    ...overrides
+  };
+}
+
+test('normalizeVendorId trims surrounding whitespace and lowercases the value', () => {
+  assert.equal(normalizeVendorId('  Acme-VENDOR  '), 'acme-vendor');
+  assert.equal(normalizeVendorId(''), '');
+  assert.equal(normalizeVendorId(null), null);
+});
+
+test('parseAssessmentJson strips a wrapping markdown fence before parsing JSON', () => {
+  const parsed = parseAssessmentJson('```json\n{"verdict":"HOLD","reasoning":" review ","riskFactors":[],"evidenceEventIds":[]}\n```');
+  assert.equal(parsed.verdict, 'HOLD');
+  assert.equal(parsed.reasoning, ' review ');
+});
+
+test('parseAssessmentJson rejects empty output and malformed JSON', () => {
+  assert.throws(() => parseAssessmentJson('   '), /risk\.assess returned empty output/);
+  assert.throws(() => parseAssessmentJson('```json\n{"verdict":\n```'), /risk\.assess returned invalid JSON/);
+});
+
+test('normalizeAssessment accepts and normalizes HOLD, APPROVE, and CHECK verdicts', () => {
+  const allowedEvidenceIds = new Set(['request-1', 'event-1', 'event-2']);
+
+  assert.deepEqual(
+    normalizeAssessment(
+      {
+        verdict: 'HOLD',
+        reasoning: '  Missing invoice context.  ',
+        riskFactors: ['  overdue account  ', ' duplicate amount '],
+        evidenceEventIds: [' event-1 ', 'request-1']
+      },
+      allowedEvidenceIds
+    ),
+    {
+      verdict: 'HOLD',
+      reasoning: 'Missing invoice context.',
+      riskFactors: ['overdue account', 'duplicate amount'],
+      evidenceEventIds: ['event-1', 'request-1']
+    }
+  );
+
+  assert.deepEqual(
+    normalizeAssessment(
+      {
+        verdict: 'APPROVE',
+        reasoning: '  History is consistent. ',
+        riskFactors: [],
+        evidenceEventIds: []
+      },
+      allowedEvidenceIds
+    ),
+    {
+      verdict: 'APPROVE',
+      reasoning: 'History is consistent.',
+      riskFactors: [],
+      evidenceEventIds: []
+    }
+  );
+
+  assert.deepEqual(
+    normalizeAssessment(
+      {
+        verdict: 'CHECK',
+        reasoning: '  Need human review for timing. ',
+        riskFactors: [' same-day change '],
+        evidenceEventIds: [' event-2 ']
+      },
+      allowedEvidenceIds
+    ),
+    {
+      verdict: 'CHECK',
+      reasoning: 'Need human review for timing.',
+      riskFactors: ['same-day change'],
+      evidenceEventIds: ['event-2']
+    }
+  );
+});
+
+test('normalizeAssessment rejects extra keys, invalid verdicts, missing fields, blank risk factors, duplicate citations, and fabricated evidence IDs', () => {
+  const allowedEvidenceIds = new Set(['request-1', 'event-1']);
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'valid',
+          riskFactors: [],
+          evidenceEventIds: [],
+          extra: true
+        },
+        allowedEvidenceIds
+      ),
+    /exactly these keys|unexpected key/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'BLOCK',
+          reasoning: 'valid',
+          riskFactors: [],
+          evidenceEventIds: []
+        },
+        allowedEvidenceIds
+      ),
+    /must be one of HOLD, APPROVE, CHECK/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'valid',
+          riskFactors: []
+        },
+        allowedEvidenceIds
+      ),
+    /exactly these keys/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'valid',
+          riskFactors: ['   '],
+          evidenceEventIds: []
+        },
+        allowedEvidenceIds
+      ),
+    /riskFactors\[0\]: must be a non-empty string/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'valid',
+          riskFactors: [],
+          evidenceEventIds: ['event-1', ' event-1 ']
+        },
+        allowedEvidenceIds
+      ),
+    /duplicate ID "event-1"/
+  );
+
+  assert.throws(
+    () =>
+      normalizeAssessment(
+        {
+          verdict: 'HOLD',
+          reasoning: 'valid',
+          riskFactors: [],
+          evidenceEventIds: ['made-up-id']
+        },
+        allowedEvidenceIds
+      ),
+    /unknown ID "made-up-id"/
+  );
+});
+
+test('selectVendorHistory matches prior events by normalized subject.id and payload.vendorId, excluding unrelated vendors and the request itself', () => {
+  const requestEvent = paymentRequestEvent();
+  const events = [
+    eventRecord({
+      id: 'older-subject-match',
+      occurredAt: '2026-09-18T14:00:00.000Z',
+      subjectId: ' Vendor-123 '
+    }),
+    eventRecord({
+      id: 'older-payload-match',
+      occurredAt: '2026-09-18T14:30:00.000Z',
+      subjectId: 'other-subject',
+      payloadVendorId: ' VENDOR-123 '
+    }),
+    eventRecord({
+      id: 'unrelated',
+      occurredAt: '2026-09-18T14:45:00.000Z',
+      subjectId: 'vendor-999',
+      payloadVendorId: 'vendor-999'
+    }),
+    requestEvent
+  ];
+
+  const selected = selectVendorHistory(events, requestEvent);
+  assert.deepEqual(
+    selected.map((event) => event.id),
+    ['older-payload-match', 'older-subject-match']
+  );
+});
+
+test('selectVendorHistory uses same-occurredAt log order for predating and returns newest first with a 20-event bound', () => {
+  const requestEvent = paymentRequestEvent({ id: 'request-20', occurredAt: '2026-09-18T15:00:00.000Z' });
+  const earlierSameTimestampBefore = eventRecord({
+    id: 'same-ts-before',
+    occurredAt: '2026-09-18T15:00:00.000Z',
+    payloadVendorId: 'vendor-123'
+  });
+  const sameTimestampAfter = eventRecord({
+    id: 'same-ts-after',
+    occurredAt: '2026-09-18T15:00:00.000Z',
+    payloadVendorId: 'vendor-123'
+  });
+
+  const olderMatches = Array.from({ length: 22 }, (_, index) =>
+    eventRecord({
+      id: `older-${index + 1}`,
+      occurredAt: `2026-09-18T14:${String(index).padStart(2, '0')}:00.000Z`,
+      payloadVendorId: 'vendor-123'
+    })
+  );
+
+  const events = [...olderMatches, earlierSameTimestampBefore, requestEvent, sameTimestampAfter];
+  const selected = selectVendorHistory(events, requestEvent);
+
+  assert.equal(selected.length, 20);
+  assert.equal(selected[0].id, 'same-ts-before');
+  assert.equal(selected[1].id, 'older-22');
+  assert.equal(selected[19].id, 'older-4');
+  assert.ok(!selected.some((event) => event.id === 'same-ts-after'));
+  assert.ok(!selected.some((event) => event.id === requestEvent.id));
+});
+
+test('selectVendorHistory returns an empty array when there is no prior matching vendor history', () => {
+  const requestEvent = paymentRequestEvent({ id: 'request-empty' });
+  const events = [
+    eventRecord({
+      id: 'future-match',
+      occurredAt: '2026-09-18T16:00:00.000Z',
+      payloadVendorId: 'vendor-123'
+    }),
+    requestEvent,
+    eventRecord({
+      id: 'other-vendor',
+      occurredAt: '2026-09-18T14:00:00.000Z',
+      payloadVendorId: 'vendor-999'
+    })
+  ];
+
+  assert.deepEqual(selectVendorHistory(events, requestEvent), []);
+});
+
+test('flag-payment-request resolves to financial authority level 3', () => {
+  assert.equal(getRequiredAuthorityLevel('flag-payment-request'), AUTHORITY_LEVELS.FINANCIAL_ACTION);
+});

Phase 1 implementation and targeted validation are complete. Repo-wide check still fails on pre-existing environment/dependency issues outside this phase.
  ✓ Update authority policy for flag-payment-request and v3
  ✓ Implement lib/roles/riskAssess.js pure helpers
  ✓ Add focused riskAssess tests and update stale phase5 v2 assertion
  ✓ Run verification and write Phase 1 handoff summary
diff --git a/.codex-spec-runner/summaries/phase-1.md b/.codex-spec-runner/summaries/phase-1.md
new file mode 100644
index 0000000000000000000000000000000000000000..66e3921dd4c3d128be5753c18681f14381b8c7ac
--- /dev/null
+++ b/.codex-spec-runner/summaries/phase-1.md
@@ -0,0 +1,38 @@
+## Implementation Handoff
+
+- Phase implemented: Phase 1 only (`lib/authority/policy.js`, new `lib/roles/riskAssess.js`, new `test/riskAssess.test.js`, targeted `test/phase5.test.js` update).
+- Policy change: bumped `ACTION_POLICY_VERSION` from `2` to `3` and added `flag-payment-request` at `AUTHORITY_LEVELS.FINANCIAL_ACTION` without altering existing mappings.
+- New helper module exports only:
+  - `normalizeVendorId`
+  - `selectVendorHistory`
+  - `parseAssessmentJson`
+  - `normalizeAssessment`
+- Intentionally did not add or export `runRiskAssess`; that remains for Phase 2.
+- `selectVendorHistory` behavior:
+  - matches by exact normalized `subject.id` or string `payload.vendorId`
+  - excludes the request event itself
+  - requires true prior history, including same-millisecond ties via earlier file order
+  - returns at most 20 newest matches, newest first, with later file order as the equal-timestamp tie-break
+- `parseAssessmentJson` reuses the repo’s markdown-fence stripping pattern before strict `JSON.parse`, and rejects empty/invalid output.
+- `normalizeAssessment` enforces the exact four-key schema, trims strings, accepts only `HOLD|APPROVE|CHECK`, and rejects extras, blanks, duplicates, and fabricated evidence IDs.
+- Updated the stale Phase 5 assertion from `/policy v2 requires 2/` to `/policy v3 requires 2/`; no other `phase5` behavior was changed.
+
+- Tests added in `test/riskAssess.test.js` cover:
+  - verdict acceptance/normalization for `HOLD`, `APPROVE`, `CHECK`
+  - empty `riskFactors` and empty `evidenceEventIds`
+  - malformed JSON, extra keys, invalid verdicts, missing fields, blank risk factors, duplicate citations, fabricated evidence IDs
+  - vendor-history selection through `subject.id` and `payload.vendorId`
+  - unrelated vendor exclusion, request-self exclusion, same-timestamp log-order predating, newest-first 20-item bound, empty-history case
+  - `flag-payment-request` resolving to authority level 3
+
+- Verification run:
+  - `node --test test/riskAssess.test.js` ✅
+  - `node --test test/phase5.test.js` ✅
+  - `node --check lib/roles/riskAssess.js` ✅
+  - `npm install` ✅
+  - `npm run check` ❌ blocked by pre-existing repo issues outside Phase 1 scope
+
+- Observed repo-wide blockers during `npm run check`:
+  - missing runtime deps in existing CLI/test paths (`@aws-sdk/client-ses` / `@smithy/core`)
+  - missing external temp module `/tmp/e3d-trade/scripts/capitalMandates.js`
+  - real integration tests expecting unavailable external services
