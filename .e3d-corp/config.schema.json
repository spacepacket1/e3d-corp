{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e3d-corp.local/schemas/instance-config.json",
  "title": "e3d-corp instance config",
  "type": "object",
  "required": ["name", "dataDir", "llm", "research", "eventSources", "roles"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "dataDir": {
      "type": "string",
      "minLength": 1
    },
    "llm": {
      "type": "object",
      "required": ["providers"],
      "properties": {
        "providers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "enum": ["local", "openai-compatible", "grok-cli"]
              },
              "baseUrlEnvVar": {
                "type": "string",
                "minLength": 1
              },
              "modelEnvVar": {
                "type": "string",
                "minLength": 1
              },
              "apiKeyEnvVar": {
                "type": "string",
                "minLength": 1
              },
              "binEnvVar": {
                "type": "string",
                "minLength": 1
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "budget": {
          "type": "object",
          "properties": {
            "period": {
              "const": "daily"
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["tokens"],
                "properties": {
                  "tokens": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "research": {
      "type": "object",
      "required": ["webSearchProvider"],
      "properties": {
        "knowledgeBaseMcpUrl": {
          "type": "string",
          "minLength": 1
        },
        "knowledgeBaseMcpServerPath": {
          "type": "string",
          "minLength": 1
        },
        "webSearchProvider": {
          "type": "string",
          "minLength": 1
        },
        "webSearchApiKeyEnvVar": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "eventSources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["provider"],
        "properties": {
          "provider": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "web": {
      "type": "object",
      "required": ["authUserEnvVar", "authPassEnvVar", "port"],
      "properties": {
        "authUserEnvVar": {
          "type": "string",
          "minLength": 1
        },
        "authPassEnvVar": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "calendar": {
      "type": "object",
      "required": ["provider", "calendarId", "organizerEmail", "serviceAccountKeyFileEnvVar"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "calendarId": { "type": "string", "minLength": 1 },
        "organizerEmail": { "type": "string", "minLength": 1 },
        "serviceAccountKeyFileEnvVar": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "required": ["provider", "toEmailEnvVar"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "toEmailEnvVar": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "outreach": {
      "type": "object",
      "required": ["provider", "region", "fromEmail"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "fromEmail": { "type": "string", "minLength": 1 },
        "fallbackToEmail": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "leadWebhook": {
      "type": "object",
      "required": ["tokenEnvVar"],
      "properties": {
        "tokenEnvVar": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "tradeOutcomeWebhook": {
      "type": "object",
      "required": ["tokenEnvVar"],
      "properties": {
        "tokenEnvVar": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "stressEvaluationWebhook": {
      "type": "object",
      "required": ["tokenEnvVar"],
      "properties": {
        "tokenEnvVar": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "e3d": {
      "type": "object",
      "required": ["baseUrl"],
      "properties": {
        "baseUrl": { "type": "string", "minLength": 1 },
        "releasePath": { "type": "string", "minLength": 1 },
        "rejectPath": { "type": "string", "minLength": 1 },
        "apiKeyEnvVar": { "type": "string", "minLength": 1 },
        "sessionCookieEnvVar": { "type": "string", "minLength": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "maxAttempts": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "authorityNotify": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "researchTopics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ownDomains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scoring": {
      "type": "object",
      "properties": {
        "weights": {
          "type": "object",
          "properties": {
            "confidence": { "type": "number" },
            "evidenceCount": { "type": "number" },
            "recency": { "type": "number" }
          },
          "additionalProperties": false
        },
        "typeWeights": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
